{
  // Production configuration. Every secret is supplied via environment variables; nothing
  // secret lives in this file or in source control. Environment-variable keys (double
  // underscore = nesting) override these values at startup:
  //   ConnectionStrings__Database, Jwt__Secret, Jwt__Issuer, Jwt__Audience,
  //   GoldApi__ApiKey, DefaultUserPassword, DefaultPlatformUserPassword.
  "ConnectionStrings": {
    "Database": ""
  },
  "App": {
    // When true, migrate + seed on startup (idempotent). Keep false for routine starts;
    // set to true (or App__MigrateOnStartup=true) for the first boot of a fresh database,
    // or apply migrations explicitly with `dotnet ef database update`.
    "MigrateOnStartup": false
  },
  "DefaultUserPassword": "",
  "DefaultPlatformUserPassword": "",
  "Tenancy": {
    "PublicHost": "goldstore.app",
    "BaseDomain": "goldstore.app",
    "Scheme": "https",
    // Keep hostname verification off for the single-host deployment (see
    // docs/host-admin-runbook.md section 6 for the subdomain enablement path).
    "RequireHostnameVerification": false,
    "ExemptPaths": [ "/health", "/health/ready", "/health/live", "/Account/Logout", "/Account/AccessDenied", "/js", "/css", "/lib", "/images" ]
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpirationInMinutes": 60,
    "RefreshExpirationInDays": 14
  },
  "GoldApi": {
    "ApiKey": "",
    "BaseUrl": "https://www.goldapi.io/api",
    "CacheDurationMinutes": 15
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
