{
  "ConnectionStrings": {
    "Database": "Server=.;Database=GoldStoreDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;",
    //"Database": "Server=db57261.public.databaseasp.net;Database=db57261;User Id=db57261;Password=mF#2A_6ibT@5;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "DefaultUserPassword":"GoldStore@321!",
  "Tenancy": {
    "PublicHost": "goldstore.app",
    "BaseDomain": "goldstore.app",
    "Scheme": "https",
    // Cookie domain stays unset so the session cookie remains scoped to the host
    // serving the app. When hostname verification is enabled on the public domain,
    // set it to the parent domain (".goldstore.app") so the login carries over to
    // tenant subdomains.
    "RequireHostnameVerification": false,
    "ExemptPaths": [ "/health", "/Account/Logout", "/Account/AccessDenied", "/js", "/css", "/lib", "/images" ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "GoldApi": {
    "ApiKey": "goldapi-ea6b9e221c91fb57d1044caa22b97399-io",
    "BaseUrl": "https://www.goldapi.io/api",
    "CacheDurationMinutes": 15
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "clean-architecture",
    "Audience": "developers",
    "ExpirationInMinutes": 60
  }
}
