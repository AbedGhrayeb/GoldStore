{
  // Local development only. Production values are supplied via environment variables
  // (ConnectionStrings__Database, Jwt__Secret/Issuer/Audience, GoldApi__ApiKey) and are
  // never committed. See appsettings.Production.json.
  "ConnectionStrings": {
    "Database": "Server=.;Database=GoldStoreDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "DefaultUserPassword":"GoldStore@321!",
  "DefaultPlatformUserPassword":"GoldStoreHost@321!",
  "Tenancy": {
    "PublicHost": "goldstore.app",
    "BaseDomain": "goldstore.app",
    "Scheme": "https",
    // Cookie domain stays unset so the session cookie remains scoped to the host
    // serving the app. When hostname verification is enabled on the public domain,
    // set it to the parent domain (".goldstore.app") so the login carries over to
    // tenant subdomains.
    "RequireHostnameVerification": false,
    "ExemptPaths": [ "/health", "/Account/Logout", "/Account/AccessDenied", "/js", "/css", "/lib", "/images" ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "GoldApi": {
    // The live API key is never committed — set GoldApi__ApiKey via user-secrets (dev)
    // or environment variables (production).
    "ApiKey": "",
    "BaseUrl": "https://www.goldapi.io/api",
    "CacheDurationMinutes": 15
  },
  "Jwt": {
    // Placeholder for local development only. Production must set Jwt__Secret, Jwt__Issuer
    // and Jwt__Audience via environment variables.
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "clean-architecture",
    "Audience": "developers",
    "ExpirationInMinutes": 60,
    "RefreshExpirationInDays": 14
  }
}
