<!DOCTYPE html>
<html lang="ar" dir="rtl" class="h-full">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - مجوهرات سرحان</title>

    <!-- Tailwind CSS (pre-built static) -->
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />

    <!-- Google Fonts: IBM Plex Sans Arabic (preloaded for fast render) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Material Symbols Outlined (non-blocking) -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />

    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="bg-background text-on-background antialiased h-full">

    <!-- ═══════════════════════════════════════════
       LAYOUT WRAPPER
  ════════════════════════════════════════════ -->
    <div class="flex h-screen overflow-hidden" id="app">

        <!-- ── SIDEBAR ────────────────────────────── -->
        <aside id="sidebar"
               class="sidebar fixed inset-y-0 right-0 z-40 w-60 bg-surface-container-lowest border-l border-outline-variant
            flex flex-col transition-transform duration-300
            translate-x-full lg:translate-x-0 lg:static lg:inset-auto lg:z-auto">
            <!-- Brand -->
            <div class="flex flex-col items-center gap-1 py-6 border-b border-outline-variant">
                <div class="w-12 h-12 rounded-xl bg-primary-container flex items-center justify-center text-on-primary-container font-bold text-lg">ب</div>
                <p class="font-semibold text-primary text-sm mt-1">مجوهرات سرحان</p>
                <p class="text-xs text-secondary">نظام إدارة الذهب</p>
            </div>

            <!-- Nav links -->
            <nav class="flex-1 py-4 px-3 space-y-1 overflow-y-auto">
               <p class="px-3 pb-1 text-xs font-label-md text-secondary uppercase tracking-wider">لوحة القيادة</p>
                <a href="#" class="nav-link" data-page="dashboard">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                    لوحة القيادة
                </a> 

                <p class="px-3 pt-4 pb-1 text-xs font-label-md text-secondary uppercase tracking-wider">المتجر</p>
                <a asp-controller="StoreOperations" asp-action="Index" class="nav-link" data-page="store-operations">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l1-5h16l1 5" /><path d="M4 9v11h16V9" /><path d="M9 20v-6h6v6" /></svg>
                    عمليات المتجر
                </a>
                <a asp-controller="SalesInvoices" asp-action="Index" class="nav-link" data-page="sales">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 7h10M7 12h6m-6 5h4" /><rect x="3" y="3" width="18" height="18" rx="2" /></svg>
                    المبيعات
                </a>
                <a asp-controller="CustomerPurchaseInvoices" asp-action="Index" class="nav-link" data-page="customer-purchases">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" /><path d="M3 6h18" /><path d="M16 10a4 4 0 01-8 0" /></svg>
                    شراء ذهب
                </a>

                <p class="px-3 pt-4 pb-1 text-xs font-label-md text-secondary uppercase tracking-wider">المخزون</p>
                <a asp-controller="Inventory" asp-action="Index" class="nav-link" data-page="inventory">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6a2 2 0 012-2h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V6z" /><path d="M3 10h18" /></svg>
                    المخزون
                </a>
                <a asp-controller="InventoryAdjustments" asp-action="Index" class="nav-link" data-page="inventory-adjustments">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 3v2M7 3v2M17 19v2M7 19v2M3 7h2M3 17h2M19 7h2M19 17h2" /><rect x="5" y="5" width="14" height="14" rx="2" /><path d="M9 12l2 2 4-4" /></svg>
                    تسويات المخزون
                </a>

                <p class="px-3 pt-4 pb-1 text-xs font-label-md text-secondary uppercase tracking-wider">الموردين</p>
                <a asp-controller="Suppliers" asp-action="Index" class="nav-link" data-page="suppliers">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="7" r="4" /><path d="M3 21v-2a4 4 0 014-4h4a4 4 0 014 4v2" /><path d="M16 3.13a4 4 0 010 7.75" /><path d="M21 21v-2a4 4 0 00-3-3.85" /></svg>
                    الموردين
                </a>
                <a asp-controller="SupplierDeliveries" asp-action="Index" class="nav-link" data-page="supplier-deliveries">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5z" /><path d="M2 17l10 5 10-5" /><path d="M2 12l10 5 10-5" /></svg>
                    توريد مورد
                </a>
                <a asp-controller="SupplierPayments" asp-action="Index" class="nav-link" data-page="supplier-payments">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2" /><path d="M7 9V7a5 5 0 0110 0v2" /><circle cx="12" cy="17" r="1" /><path d="M12 18v2" /></svg>
                    دفعات المورد
                </a>
                <a asp-controller="SupplierFinancialTransactions" asp-action="Index" class="nav-link" data-page="supplier-financial-transactions">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" /></svg>
                    المعاملات المالية
                </a>

                <p class="px-3 pt-4 pb-1 text-xs font-label-md text-secondary uppercase tracking-wider">المالية</p>
                <a asp-controller="FinancialAccounts" asp-action="Index" class="nav-link" data-page="finance">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" /><circle cx="12" cy="14" r="2" /></svg>
                    المالية
                </a>
                <a asp-controller="Expenses" asp-action="Index" class="nav-link" data-page="expenses">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" /></svg>
                    المصروفات
                </a>
                <a asp-controller="Debts" asp-action="Index" class="nav-link" data-page="debts">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" /></svg>
                    الذمم
                </a>

                <p class="px-3 pt-4 pb-1 text-xs font-label-md text-secondary uppercase tracking-wider">التكوين</p>
                <a asp-controller="Categories" asp-action="Index" class="nav-link" data-page="categories">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
                    التصنيفات
                </a>

                <p class="px-3 pt-4 pb-1 text-xs font-label-md text-secondary uppercase tracking-wider">الموارد البشرية</p>
                <a asp-controller="Employees" asp-action="Index" class="nav-link" data-page="employees">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    الموظفون
                </a>
                <a asp-controller="SalaryPayments" asp-action="Index" class="nav-link" data-page="salary-payments">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7zm2 2h2m2 0h2M7 9v2m0 0H5m2 0v2m0-2h2m6-1h4m-4 0a2 2 0 100 4 2 2 0 000-4z"/></svg>
                    دفعات الرواتب
                </a>
            </nav>

            <!-- Bottom actions -->
            <div class="border-t border-outline-variant px-3 py-4 space-y-1">
                <form asp-action="Logout" asp-controller="Account" method="post" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link text-red-500 hover:bg-red-50">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                    تسجيل الخروج
                </button>
                </form>
            </div>
        </aside>

        <!-- Sidebar overlay (mobile) -->
        <div id="sidebar-overlay" class="fixed inset-0 bg-black/40 z-30 hidden lg:hidden" onclick="closeSidebar()"></div>

        <!-- ── MAIN CONTENT ────────────────────────── -->
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">

            <!-- TOP NAV BAR -->
            <header class="h-14 bg-surface-container-lowest/80 backdrop-blur-md border-b border-outline-variant flex items-center justify-between px-gutter flex-shrink-0 z-20">
                <!-- Left: hamburger (mobile) + search -->
                <div class="flex items-center gap-3">
                    <!-- Hamburger (mobile only) -->
                    <button class="lg:hidden p-2 rounded-lg hover:bg-surface-container-low text-secondary" onclick="openSidebar()" aria-label="القائمة">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                    </button>

                    <!-- Search -->
                    <div class="relative hidden sm:flex items-center">
                        <svg class="absolute right-3 w-4 h-4 text-secondary pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" /></svg>
                        <input type="search"
                               placeholder="بحث..."
                               class="pr-9 pl-4 py-1.5 w-52 lg:w-64 bg-surface-container border border-outline-variant rounded-lg text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30 transition" />
                    </div>
                </div>

                <!-- Right: page title + actions -->
                <div class="flex items-center gap-3">
                    <!-- Notifications -->
                    <button class="relative p-2 rounded-lg hover:bg-surface-container-low text-secondary" aria-label="الإشعارات">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 01-3.46 0" /></svg>
                        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>

                    <!-- Settings -->
                    <button class="p-2 rounded-lg hover:bg-surface-container-low text-secondary" aria-label="الإعدادات">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" /></svg>
                    </button>

                    <!-- Page title -->
                    <a asp-action="Index" asp-controller="Home" class="nav-link active" data-page="dashboard">
                    <h1 class="font-bold text-base lg:text-lg text-primary">لوحة القيادة</h1>
                    </a>
                    <!-- Avatar -->
                    <a asp-controller="Users" asp-action="Profile" class="w-9 h-9 rounded-full bg-primary-container overflow-hidden flex items-center justify-center cursor-pointer border-2 border-primary/20 hover:border-primary/50 transition" title="ملفي الشخصي">
                        <svg class="w-6 h-6 text-on-primary-container" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" /></svg>
                    </a>
                </div>
            </header>

            <!-- PAGE BODY -->
            <main class="flex-1 overflow-y-auto p-md lg:p-gutter space-y-md bg-surface">

                @RenderBody()
            </main>
        </div><!-- /main content -->
    </div><!-- /app -->

    <!-- ═══════════════════════════════════════════
       SHARED MODAL — loaded dynamically via AJAX
   ════════════════════════════════════════════ -->
    <div id="openModal" class="fixed inset-0 z-50 hidden">
        <div class="absolute inset-0 bg-black/50" id="openModalOverlay"></div>
        <div class="absolute inset-0 flex items-center justify-center p-4">
            <div class="bg-surface-container-lowest rounded-xl shadow-xl w-full max-w-md max-h-[90vh] overflow-y-auto" id="openModalContent">
            </div>
        </div>
    </div>

    <!-- JS Libraries (at end of body for non-blocking render) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.form/4.3.0/jquery.form.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

