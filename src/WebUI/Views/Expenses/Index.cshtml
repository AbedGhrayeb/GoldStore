@{
    Layout = "_Layout";
    ViewData["Title"] = "المصروفات";
}

<link rel="stylesheet" href="~/css/expenses.css" />

<!-- Header Section -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-xl gap-md">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs">المصروفات</h2>
        <p class="font-body-lg text-body-lg text-secondary">إدارة ومتابعة المصروفات اليومية والشهرية.</p>
    </div>
    <div class="flex gap-sm">
        <button class="flex items-center gap-xs px-md py-sm bg-surface-container-lowest border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container transition-colors shadow-sm" onclick="openCategoryManager()">
            <span class="material-symbols-outlined text-[18px]">category</span>
            إدارة التصنيفات
        </button>
        <button class="flex items-center gap-xs px-md py-sm bg-primary-container text-on-primary-container rounded-lg font-label-md text-label-md hover:bg-inverse-primary transition-colors shadow-sm" onclick="openCreateExpenseModal()">
            <span class="material-symbols-outlined text-[18px]">add</span>
            إضافة مصروف
        </button>
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-xl">
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-md shadow-[0px_4px_20px_rgba(0,0,0,0.04)]">
        <div class="flex items-center gap-sm mb-xs">
            <span class="material-symbols-outlined text-primary text-xl">today</span>
            <span class="font-label-md text-label-md text-secondary">مصروفات اليوم</span>
        </div>
        <div id="kpiTodayTotals" class="space-y-xs"></div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-md shadow-[0px_4px_20px_rgba(0,0,0,0.04)]">
        <div class="flex items-center gap-sm mb-xs">
            <span class="material-symbols-outlined text-primary text-xl">calendar_month</span>
            <span class="font-label-md text-label-md text-secondary">مصروفات الشهر</span>
        </div>
        <div id="kpiMonthTotals" class="space-y-xs"></div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-md shadow-[0px_4px_20px_rgba(0,0,0,0.04)]">
        <div class="flex items-center gap-sm mb-xs">
            <span class="material-symbols-outlined text-primary text-xl">label</span>
            <span class="font-label-md text-label-md text-secondary">أعلى تصنيف</span>
        </div>
        <div class="font-title-lg text-title-lg text-on-surface" id="kpiTopCategory">—</div>
        <div id="kpiTopCategoryAmounts" class="space-y-xs"></div>
    </div>
</div>

<!-- Filters -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-md mb-gutter shadow-[0px_4px_20px_rgba(0,0,0,0.04)]">
    <div class="flex flex-wrap gap-md items-end">
        <div class="flex-1 min-w-[150px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">اسم الحساب</label>
            <input type="text" id="filterAccountName" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" placeholder="بحث بالحساب..." />
        </div>
        <div class="flex-1 min-w-[130px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">من تاريخ</label>
            <input type="date" id="filterFromDate" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" />
        </div>
        <div class="flex-1 min-w-[130px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">إلى تاريخ</label>
            <input type="date" id="filterToDate" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" />
        </div>
        <div class="flex-1 min-w-[150px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">التصنيف</label>
            <select id="filterCategoryId" class="w-full appearance-none bg-surface border border-outline-variant rounded-lg py-2 px-3 pr-10 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm">
                <option value="">الكل</option>
            </select>
        </div>
        <button class="px-md py-sm bg-primary-container text-on-primary-container rounded-lg font-label-md text-label-md hover:bg-inverse-primary transition-colors shadow-sm" onclick="loadExpenses()">
            <span class="material-symbols-outlined text-[18px] align-middle">filter_list</span>
            تصفية
        </button>
    </div>
</div>

<!-- Expenses Table -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.04)] overflow-hidden">
    <div class="p-md border-b border-outline-variant flex justify-between items-center bg-surface-container-low">
        <h4 class="font-title-lg text-title-lg text-on-surface">سجل المصروفات</h4>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse" id="expensesTable">
            <thead>
                <tr class="bg-surface-container-highest/30">
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">التاريخ</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">التصنيف</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الوصف</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">المبلغ</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الحساب</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody id="expensesBody" class="font-body-md text-body-md text-on-surface">
                <tr>
                    <td colspan="6" class="py-12 text-center text-secondary">جاري التحميل...</td>
                </tr>
            </tbody>
        </table>
    </div>
    <!-- Pagination -->
    <div class="p-md border-t border-outline-variant flex justify-between items-center" id="paginationContainer" style="display:none;">
        <span class="font-label-md text-label-md text-secondary" id="paginationInfo"></span>
        <div class="flex gap-sm" id="paginationButtons"></div>
    </div>
</div>

<!-- Create/Edit Expense Modal -->
<div id="expenseModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50" onclick="closeExpenseModal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-surface-container-lowest rounded-xl shadow-xl w-full max-w-md max-h-[90vh] overflow-y-auto">
            <div class="p-md border-b border-outline-variant flex justify-between items-center">
                <h3 class="font-title-lg text-title-lg text-on-surface" id="expenseModalTitle">إضافة مصروف</h3>
                <button class="p-1 text-secondary hover:text-on-surface transition-colors" onclick="closeExpenseModal()">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <form id="expenseForm" class="p-md space-y-md" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="expenseId" value="" />
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">تاريخ المصروف</label>
                    <input type="date" id="expenseDate" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" />
                    <span class="text-xs text-error hidden" id="expenseDateError">تاريخ المصروف مطلوب</span>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">التصنيف</label>
                    <select id="expenseCategoryId" class="w-full appearance-none bg-surface border border-outline-variant rounded-lg py-2 px-3 pr-10 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm">
                        <option value="">بدون تصنيف</option>
                    </select>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">الوصف</label>
                    <input type="text" id="expenseDescription" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" placeholder="وصف المصروف..." maxlength="500" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">المبلغ</label>
                    <input type="number" id="expenseAmount" step="0.001" min="0.001" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-data-mono text-data-mono text-left focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" placeholder="0.000" />
                    <span class="text-xs text-error hidden" id="expenseAmountError">المبلغ مطلوب</span>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">حساب الدفع</label>
                    <select id="expenseAccountId" class="w-full appearance-none bg-surface border border-outline-variant rounded-lg py-2 px-3 pr-10 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm">
                        <option value="">اختر الحساب...</option>
                    </select>
                    <span class="text-xs text-error hidden" id="expenseAccountIdError">يجب اختيار حساب الدفع</span>
                </div>
                <div class="pt-sm">
                    <button type="button" id="btnSubmitExpense" class="w-full bg-primary-container text-on-primary-container font-body-lg text-body-lg font-bold py-2 rounded-lg hover:bg-inverse-primary transition-colors shadow-sm" onclick="submitExpense()">
                        إضافة المصروف
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Category Manager Modal -->
<div id="categoryModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50" onclick="closeCategoryManager()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-surface-container-lowest rounded-xl shadow-xl w-full max-w-sm max-h-[80vh] overflow-y-auto">
            <div class="p-md border-b border-outline-variant flex justify-between items-center">
                <h3 class="font-title-lg text-title-lg text-on-surface">إدارة تصنيفات المصروفات</h3>
                <button class="p-1 text-secondary hover:text-on-surface transition-colors" onclick="closeCategoryManager()">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-md space-y-md">
                <div class="flex gap-sm">
                    <input type="text" id="newCategoryName" class="flex-1 bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" placeholder="اسم التصنيف الجديد..." />
                    <button class="px-sm py-sm bg-primary-container text-on-primary-container rounded-lg font-label-md text-label-md hover:bg-inverse-primary transition-colors" onclick="createCategory()">إضافة</button>
                </div>
                <div id="categoriesList" class="space-y-sm"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/expenses.js" asp-append-version="true"></script>
}