@model WebUI.Models.Supplier.CreateSupplierModel
@{
    Layout = null;
}
<form asp-action="AddOrUpdateAjax" asp-controller="Suppliers" method="post" class="ajaxForm space-y-5">
    @Html.AntiForgeryToken()
    <div class="flex items-center justify-between p-4 sm:p-6 border-b border-outline-variant">
        <h2 class="text-lg sm:text-xl font-bold text-on-surface">إضافة مورد جديد</h2>
        <button type="button" class="p-2 hover:bg-gray-100 rounded-lg transition-colors" onclick="closeModal()">
            <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>
    <div class="p-4 sm:p-6">
        <div>
            <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-2">اسم المورد *</label>
            <input asp-for="Name" class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors" placeholder="أدخل اسم المورد" />
            <span asp-validation-for="Name" class="text-danger text-sm mt-1 invalid-feedback"></span>
        </div>
        <div class="mt-4">
            <label asp-for="PrimaryPhone" class="block text-sm font-medium text-gray-700 mb-2">رقم الهاتف الأساسي *</label>
            <input asp-for="PrimaryPhone" class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors" placeholder="مثال: 0791234567" dir="ltr" />
            <span asp-validation-for="PrimaryPhone" class="text-danger text-sm mt-1 invalid-feedback"></span>
        </div>
        <div class="mt-4">
            <label asp-for="SecondaryPhone" class="block text-sm font-medium text-gray-700 mb-2">رقم الهاتف الثانوي</label>
            <input asp-for="SecondaryPhone" class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors" placeholder="اختياري" dir="ltr" />
            <span asp-validation-for="SecondaryPhone" class="text-danger text-sm mt-1 invalid-feedback"></span>
        </div>
        <div class="mt-4">
            <label asp-for="BankAccountNumber" class="block text-sm font-medium text-gray-700 mb-2">رقم الحساب البنكي *</label>
            <input asp-for="BankAccountNumber" class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors" placeholder="أدخل رقم الحساب البنكي" />
            <span asp-validation-for="BankAccountNumber" class="text-danger text-sm mt-1 invalid-feedback"></span>
        </div>
        <div class="mt-4">
            <label asp-for="Notes" class="block text-sm font-medium text-gray-700 mb-2">ملاحظات</label>
            <textarea asp-for="Notes" rows="3" class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors resize-none" placeholder="ملاحظات اختيارية"></textarea>
            <span asp-validation-for="Notes" class="text-danger text-sm mt-1 invalid-feedback"></span>
        </div>
        <div class="flex gap-3 pt-6">
            <button type="button" class="flex-1 px-6 py-2.5 border border-gray-200 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors" onclick="closeModal()">إلغاء</button>
            <button type="submit" class="flex-1 px-6 py-2.5 bg-primary hover:bg-gold/90 text-white rounded-lg font-medium transition-colors">حفظ</button>
        </div>
    </div>
</form>