@{
    Layout = "_Layout";
    ViewData["Title"] = "إدارة الموردين";
}

<link rel="stylesheet" href="~/css/suppliers.css" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

<div class="suppliers-layout">
    <!-- Suppliers Table Panel -->
    <div class="suppliers-list-panel bg-surface-container-lowest rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.04)]">
        <!-- Header -->
        <div class="p-4 border-b border-outline-variant flex justify-between items-center bg-surface-container-low/50">
            <div>
                <h2 class="text-xl font-bold text-on-surface">إدارة الموردين</h2>
                <p class="text-secondary text-sm mt-1">قائمة بجميع موردي الذهب والخدمات</p>
            </div>
            <a asp-action="AddOrUpdate" asp-controller="Suppliers" ajaxType="GET" title="إضافة مورد جديد"
               class="openModal bg-primary-container text-on-primary px-4 py-2 rounded-lg font-medium flex items-center gap-2 hover:bg-primary transition-colors cursor-pointer">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                إضافة مورد
            </a>
        </div>

        <!-- Filter Tabs & Search -->
        <div class="p-3 border-b border-outline-variant flex gap-2 bg-surface items-center">
            <button class="filter-tab active" data-count-type="all" onclick="filterSuppliers('all')">الكل (<span id="countAll">0</span>)</button>
            <button class="filter-tab" data-count-type="active" onclick="filterSuppliers('active')">نشط (<span id="countActive">0</span>)</button>
            <button class="filter-tab" data-count-type="stopped" onclick="filterSuppliers('stopped')">متوقف (<span id="countStopped">0</span>)</button>
            <div class="flex-1"></div>
            <div class="relative w-64">
                <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-secondary pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input type="text" id="supplierSearch" placeholder="البحث عن مورد..."
                       class="w-full pr-9 pl-3 py-2 bg-surface-container-lowest border border-outline rounded-lg text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30"
                       oninput="searchSuppliers()" />
            </div>
        </div>

        <!-- Desktop Table -->
        <div class="hidden lg:block flex-1 overflow-y-auto">
            <table class="supplier-table">
                <thead>
                    <tr>
                        <th class="text-right">اسم المورد</th>
                        <th class="text-right">رصيد الذهب (جم)</th>
                        <th class="text-right">أجور التصنيع (د.إ)</th>
                        <th class="text-right">الحالة</th>
                        <th class="text-right">الإجراءات</th>
                    </tr>
                </thead>
                <tbody id="suppliersTableBody">
                    <tr>
                        <td colspan="5" class="text-center py-12 text-secondary">جاري التحميل...</td>
                    </tr>
                </tbody>
            </table>
            <div id="emptyStateDesktop" class="hidden text-center py-12">
                <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <p class="text-secondary">لا يوجد موردين</p>
                <a asp-action="AddOrUpdate" asp-controller="Suppliers" ajaxType="GET" title="إضافة مورد جديد"
                   class="openModal text-gold hover:underline mt-2 cursor-pointer">إضافة مورد جديد</a>
            </div>
        </div>

        <!-- Mobile Cards -->
        <div class="lg:hidden flex-1 overflow-y-auto p-4 space-y-3" id="suppliersCards">
            <div class="text-center py-12 text-secondary">جاري التحميل...</div>
        </div>
        <div id="emptyStateMobile" class="hidden text-center py-12 lg:hidden">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p class="text-secondary">لا يوجد موردين</p>
            <a asp-action="AddOrUpdate" asp-controller="Suppliers" ajaxType="GET" title="إضافة مورد جديد"
               class="openModal text-gold hover:underline mt-2 block mx-auto cursor-pointer">إضافة مورد جديد</a>
        </div>

        <!-- No Results -->
        <div id="noResults" class="hidden text-center py-12">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <p class="text-secondary">لا توجد نتائج مطابقة للبحث</p>
        </div>
    </div>

    <!-- Detail Panel (Desktop) -->
    <div class="hidden lg:flex suppliers-detail-panel bg-surface-container-lowest rounded-xl border border-outline-variant shadow-[0px_10px_32px_rgba(0,0,0,0.08)]" id="detailPanel">
        <div class="flex flex-col h-full w-full" id="detailContent">
            <div class="flex-1 flex items-center justify-center p-8">
                <div class="text-center">
                    <svg class="w-16 h-16 text-outline-variant mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <p class="text-secondary text-sm">اختر موردًا لعرض التفاصيل</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Slide-Over Detail Panel -->
<div id="mobileDetailOverlay" class="supplier-slide-overlay hidden" onclick="closeMobileDetail()"></div>
<div id="mobileDetailPanel" class="supplier-slide-over">
    <div class="flex items-center justify-between p-4 border-b border-outline-variant bg-surface-container-low sticky top-0 z-10">
        <h3 class="text-lg font-bold text-on-surface">تفاصيل المورد</h3>
        <button onclick="closeMobileDetail()" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
            <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>
    <div class="overflow-y-auto flex-1 p-4" id="mobileDetailContent"></div>
</div>

@section Scripts {
    <script src="~/js/suppliers.js" asp-append-version="true"></script>
}