@model WebUI.Models.Category.EditCategoryModel
@{
    ViewData["Title"] = "تعديل التصنيف";
}
<form method="post" asp-action="Edit" id="editForm" class="space-y-5">
    @Html.AntiForgeryToken()
    <input type="hidden" id="editCatId" name="Id" value="@Model.Id" />
    <div>
        <label for="editCatName" class="block text-sm font-medium text-gray-700 mb-2">اسم التصنيف</label>
        <input type="text" id="editCatName" name="Name" required maxlength="200" value="@Model.Name"
               class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors"
               placeholder="أدخل اسم التصنيف" />
        <p id="editCatNameError" class="text-red-500 text-sm mt-1 hidden"></p>
    </div>
    <div>
        <label for="editCatDescription" class="block text-sm font-medium text-gray-700 mb-2">الوصف</label>
        <textarea id="editCatDescription" name="Description" rows="3" maxlength="500"
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors resize-none"
                  placeholder="وصف اختياري للتصنيف">@Model.Description</textarea>
        <p id="editCatDescriptionError" class="text-red-500 text-sm mt-1 hidden"></p>
    </div>
    <div>
        <label for="editCatParent" class="block text-sm font-medium text-gray-700 mb-2">التصنيف الأب</label>
        <select id="editCatParent" name="ParentCategoryId"
                class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors">
            <option value="">— بدون تصنيف أب —</option>
        </select>
    </div>
    <div class="flex items-center gap-3">
        <input type="checkbox" id="editCatIsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")
               class="w-4 h-4 text-gold border-gray-300 rounded focus:ring-gold" />
        <label for="editCatIsActive" class="text-sm font-medium text-gray-700">نشط</label>
        <input type="hidden" name="IsActive" value="false" />
    </div>
    <div id="editCatError" class="hidden bg-red-50 border border-red-200 rounded-lg p-4">
        <p class="text-red-600 text-sm" id="editCatErrorMessage"></p>
    </div>
    <div class="flex gap-3 pt-4">
        <button type="button" onclick="closeEditModal()" class="flex-1 px-6 py-2.5 border border-gray-200 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
            إلغاء
        </button>
        <button type="submit" class="flex-1 px-6 py-2.5 bg-primary hover:bg-gold/90 text-white rounded-lg font-medium transition-colors">
            حفظ التغييرات
        </button>
    </div>
</form>