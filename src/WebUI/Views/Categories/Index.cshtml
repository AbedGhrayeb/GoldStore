@model List<WebUI.Models.Category.CategoryModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "إدارة التصنيفات";
}
<div id="toast" class="fixed top-4 left-1/2 transform -translate-x-1/2 z-[100] hidden">
    <div class="bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg flex items-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span id="toastMessage">تم الحفظ بنجاح</span>
    </div>
</div>

<div class="bg-surface min-h-screen">
    <div class="p-4 sm:p-6 max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-900">إدارة التصنيفات</h1>
                <p class="text-gray-500 text-sm mt-1">إنشاء وتعديل تصنيفات المنتجات الذهبية</p>
            </div>
            <button onclick="openCreateModal()" class="bg-primary hover:bg-gold/90 text-white px-5 py-2.5 rounded-lg font-medium flex items-center justify-center gap-2 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                إضافة تصنيف
            </button>
        </div>

        <!-- Search -->
        <div class="mb-4">
            <div class="relative">
                <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input type="text" id="searchInput" placeholder="بحث في التصنيفات..."
                       class="w-full pr-10 pl-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors text-sm"
                       oninput="filterCategories()" />
            </div>
        </div>

        <!-- Desktop Table (hidden on mobile) -->
        <div class="hidden sm:block bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto max-h-[65vh] overflow-y-auto m-2">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-100 sticky top-0 z-10">
                        <tr>
                            <th class="text-right py-3 px-4 text-sm font-semibold text-gray-700">اسم التصنيف</th>
                            <th class="text-right py-3 px-4 text-sm font-semibold text-gray-700">الوصف</th>
                            <th class="text-right py-3 px-4 text-sm font-semibold text-gray-700">التصنيف الأب</th>
                            <th class="text-right py-3 px-4 text-sm font-semibold text-gray-700">الحالة</th>
                            <th class="text-right py-3 px-4 text-sm font-semibold text-gray-700">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50" id="categoriesTableBody">
                        @foreach (var category in Model)
                        {
                            <tr class="hover:bg-gray-50 transition-colors category-row"
                                data-category-id="@category.Id"
                                data-category-name="@category.Name"
                                data-category-description="@(category.Description ?? "")"
                                data-category-parent-id="@(category.ParentCategoryId?.ToString() ?? "")"
                                data-category-parent-name="@(category.ParentCategoryName ?? "")"
                                data-category-is-active="@category.IsActive.ToString().ToLower()"
                                data-search-text="@(category.Name) @(category.Description) @(category.ParentCategoryName)">
                                <td class="py-3 px-4">
                                    <span class="font-medium text-gray-900">@category.Name</span>
                                </td>
                                <td class="py-3 px-4 text-gray-500 text-sm max-w-[200px] truncate">@category.Description</td>
                                <td class="py-3 px-4">
                                    @if (category.ParentCategoryName != null)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">@category.ParentCategoryName</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">—</span>
                                    }
                                </td>
                                <td class="py-3 px-4">
                                    @if (category.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">غير نشط</span>
                                    }
                                </td>
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-1">
                                        <button onclick="openEditModal('@category.Id')"
                                                class="p-1.5 text-gray-400 hover:text-gold hover:bg-gold/5 rounded-lg transition-colors"
                                                title="تعديل">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                            </svg>
                                        </button>
                                        <button onclick="toggleActive('@category.Id', this)"
                                                class="p-1.5 @(category.IsActive ? "text-green-500 hover:text-red-500 hover:bg-red-50" : "text-red-400 hover:text-green-500 hover:bg-green-50") rounded-lg transition-colors"
                                                title="@(category.IsActive ? "إلغاء التفعيل" : "تفعيل")">
                                            @if (category.IsActive)
                                            {
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                </svg>
                                            }
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Count == 0)
            {
                <div class="text-center py-12" id="emptyState">
                    <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                    <p class="text-gray-500">لا يوجد تصنيفات</p>
                    <button onclick="openCreateModal()" class="text-gold hover:underline mt-2 inline-block">إضافة تصنيف جديد</button>
                </div>
            }
        </div>

        <!-- Mobile Cards (visible only on mobile) -->
        <div class="sm:hidden space-y-3" id="categoriesCards">
            @foreach (var category in Model)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 category-card"
                     data-category-id="@category.Id"
                     data-category-name="@category.Name"
                     data-category-description="@(category.Description ?? "")"
                     data-category-parent-id="@(category.ParentCategoryId?.ToString() ?? "")"
                     data-category-parent-name="@(category.ParentCategoryName ?? "")"
                     data-category-is-active="@category.IsActive.ToString().ToLower()"
                     data-search-text="@(category.Name) @(category.Description) @(category.ParentCategoryName)">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-medium text-gray-900">@category.Name</h3>
                                @if (category.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">نشط</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700">غير نشط</span>
                                }
                            </div>
                            @if (category.ParentCategoryName != null)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700 mt-1">@category.ParentCategoryName</span>
                            }
                            @if (category.Description != null)
                            {
                                <p class="text-gray-500 text-sm mt-1 truncate">@category.Description</p>
                            }
                        </div>
                        <div class="flex items-center gap-1 flex-shrink-0">
                            <button onclick="openEditModal('@category.Id')"
                                    class="p-2 text-gray-400 hover:text-gold hover:bg-gold/5 rounded-lg transition-colors"
                                    title="تعديل">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                            </button>
                            <button onclick="toggleActive('@category.Id', this)"
                                    class="p-2 @(category.IsActive ? "text-green-500 hover:text-red-500 hover:bg-red-50" : "text-red-400 hover:text-green-500 hover:bg-green-50") rounded-lg transition-colors"
                                    title="@(category.IsActive ? "إلغاء التفعيل" : "تفعيل")">
                                @if (category.IsActive)
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- No results message (hidden by default) -->
        <div id="noResults" class="hidden text-center py-12">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <p class="text-gray-500">لا توجد نتائج مطابقة للبحث</p>
        </div>
    </div>
</div>

<!-- Create Category Modal -->
<div id="createModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50" onclick="closeCreateModal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-gray-100">
                <h2 class="text-lg sm:text-xl font-bold text-gray-900">إضافة تصنيف جديد</h2>
                <button onclick="closeCreateModal()" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
                    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="p-4 sm:p-6" id="createModalContent">
                @await Html.PartialAsync("Partials/_CreateModal", new WebUI.Models.Category.CreateCategoryModel())
            </div>
        </div>
    </div>
</div>

<!-- Edit Category Modal -->
<div id="editModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50" onclick="closeEditModal()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-md max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between p-4 sm:p-6 border-b border-gray-100">
                <h2 class="text-lg sm:text-xl font-bold text-gray-900">تعديل التصنيف</h2>
                <button onclick="closeEditModal()" class="p-2 hover:bg-gray-100 rounded-lg transition-colors">
                    <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="p-4 sm:p-6" id="editModalContent">
                @await Html.PartialAsync("Partials/_EditModal", new WebUI.Models.Category.EditCategoryModel())
            </div>
        </div>
    </div>
</div>

<script>
    let allCategories = [];

    // Toast
    function showToast(message, isSuccess = true) {
        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toastMessage');
        toastMessage.textContent = message;
        toast.querySelector('div').className = isSuccess
            ? 'bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg flex items-center gap-3'
            : 'bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg flex items-center gap-3';
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3000);
    }

    // Search / Filter
    function filterCategories() {
        const query = document.getElementById('searchInput').value.trim().toLowerCase();
        const rows = document.querySelectorAll('.category-row');
        const cards = document.querySelectorAll('.category-card');
        let visibleCount = 0;

        rows.forEach(row => {
            const text = (row.getAttribute('data-search-text') || '').toLowerCase();
            const match = !query || text.includes(query);
            row.style.display = match ? '' : 'none';
            if (match) visibleCount++;
        });

        cards.forEach(card => {
            const text = (card.getAttribute('data-search-text') || '').toLowerCase();
            const match = !query || text.includes(query);
            card.style.display = match ? '' : 'none';
        });

        const noResults = document.getElementById('noResults');
        const emptyState = document.getElementById('emptyState');
        if (visibleCount === 0 && query) {
            noResults.classList.remove('hidden');
            if (emptyState) emptyState.classList.add('hidden');
        } else {
            noResults.classList.add('hidden');
        }
    }

    // Clear validation errors
    function clearValidationErrors(modalId) {
        document.querySelectorAll('#' + modalId + ' .border-red-500').forEach(el => el.classList.remove('border-red-500'));
        document.querySelectorAll('#' + modalId + ' [id$="Error"]').forEach(el => { el.classList.add('hidden'); el.textContent = ''; });
        const errorDiv = document.getElementById(modalId + 'Error') || document.getElementById(modalId.charAt(0).toLowerCase() + modalId.slice(1) + 'Error');
        if (errorDiv) errorDiv.classList.add('hidden');
    }

    function showFieldError(fieldId, message) {
        const input = document.getElementById(fieldId);
        const error = document.getElementById(fieldId + 'Error');
        if (input) input.classList.add('border-red-500');
        if (error) { error.textContent = message; error.classList.remove('hidden'); }
    }

    // Load categories for parent dropdown
    async function loadCategories(selectId, excludeId = null) {
        try {
            const response = await fetch('@Url.Action("GetAll", "Categories")');
            const data = await response.json();
            allCategories = data;
            const select = document.getElementById(selectId);
            if (!select) return;
            select.innerHTML = '<option value="">— بدون تصنيف أب —</option>';
            data.forEach(cat => {
                if (cat.id !== excludeId) {
                    const option = document.createElement('option');
                    option.value = cat.id;
                    option.textContent = cat.name;
                    select.appendChild(option);
                }
            });
        } catch (e) {
            console.error('Failed to load categories', e);
        }
    }

    // Create Modal
    function openCreateModal() {
        document.getElementById('createCatName').value = '';
        document.getElementById('createCatDescription').value = '';
        document.getElementById('createCatIsActive').checked = true;
        clearValidationErrors('createCat');
        const errorDiv = document.getElementById('createCatError');
        if (errorDiv) errorDiv.classList.add('hidden');
        loadCategories('createCatParent');
        document.getElementById('createModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeCreateModal() {
        document.getElementById('createModal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    function handleCreateSubmit(event) {
        event.preventDefault();
        const form = event.target;
        const formData = new FormData(form);
        clearValidationErrors('createCat');
        const errorDiv = document.getElementById('createCatError');
        if (errorDiv) errorDiv.classList.add('hidden');

        fetch(form.action, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
            body: formData
        }).then(response => response.json())
          .then(data => {
            if (data.success) {
                closeCreateModal();
                showToast('تم إضافة التصنيف بنجاح');
                setTimeout(() => window.location.reload(), 1500);
            } else {
                if (data.errors) {
                    for (const [field, messages] of Object.entries(data.errors)) {
                        if (Array.isArray(messages)) messages.forEach(msg => showFieldError('createCat' + field, msg));
                    }
                }
                if (data.error) {
                    const errDiv = document.getElementById('createCatError');
                    const errMsg = document.getElementById('createCatErrorMessage');
                    errMsg.textContent = data.error;
                    errDiv.classList.remove('hidden');
                }
            }
        }).catch(() => {
            const errDiv = document.getElementById('createCatError');
            const errMsg = document.getElementById('createCatErrorMessage');
            errMsg.textContent = 'حدث خطأ أثناء الاتصال بالخادم';
            errDiv.classList.remove('hidden');
        });
        return false;
    }

    // Edit Modal
    function openEditModal(categoryId) {
        // Try table row first, then card
        const row = document.querySelector(`[data-category-id="${categoryId}"]`);
        if (!row) return;

        const id = row.getAttribute('data-category-id');
        const name = row.getAttribute('data-category-name');
        const description = row.getAttribute('data-category-description');
        const parentId = row.getAttribute('data-category-parent-id');
        const isActive = row.getAttribute('data-category-is-active') === 'true';

        document.getElementById('editCatId').value = id;
        document.getElementById('editCatName').value = name;
        document.getElementById('editCatDescription').value = description;
        document.getElementById('editCatIsActive').checked = isActive;

        clearValidationErrors('editCat');
        const errorDiv = document.getElementById('editCatError');
        if (errorDiv) errorDiv.classList.add('hidden');

        loadCategories('editCatParent', id).then(() => {
            const select = document.getElementById('editCatParent');
            if (parentId) select.value = parentId;
        });

        document.getElementById('editModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeEditModal() {
        document.getElementById('editModal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    function handleEditSubmit(event) {
        event.preventDefault();
        const form = event.target;
        const formData = new FormData(form);
        clearValidationErrors('editCat');
        const errorDiv = document.getElementById('editCatError');
        if (errorDiv) errorDiv.classList.add('hidden');

        fetch(form.action, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
            body: formData
        }).then(response => response.json())
          .then(data => {
            if (data.success) {
                closeEditModal();
                showToast('تم تحديث التصنيف بنجاح');
                setTimeout(() => window.location.reload(), 1500);
            } else {
                if (data.errors) {
                    for (const [field, messages] of Object.entries(data.errors)) {
                        if (Array.isArray(messages)) messages.forEach(msg => showFieldError('editCat' + field, msg));
                    }
                }
                if (data.error) {
                    const errDiv = document.getElementById('editCatError');
                    const errMsg = document.getElementById('editCatErrorMessage');
                    errMsg.textContent = data.error;
                    errDiv.classList.remove('hidden');
                }
            }
        }).catch(() => {
            const errDiv = document.getElementById('editCatError');
            const errMsg = document.getElementById('editCatErrorMessage');
            errMsg.textContent = 'حدث خطأ أثناء الاتصال بالخادم';
            errDiv.classList.remove('hidden');
        });
        return false;
    }

    // Toggle Active
    async function toggleActive(categoryId, button) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        try {
            const response = await fetch('@Url.Action("ToggleActive", "Categories")', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `id=${categoryId}&__RequestVerificationToken=${encodeURIComponent(token)}`
            });
            const data = await response.json();
            if (data.success) {
                showToast('تم تحديث حالة التصنيف بنجاح');
                setTimeout(() => window.location.reload(), 1500);
            } else {
                showToast(data.error || 'حدث خطأ أثناء التحديث', false);
            }
        } catch {
            showToast('حدث خطأ أثناء الاتصال بالخادم', false);
        }
    }

    // Form submit handlers
    document.getElementById('createForm').addEventListener('submit', handleCreateSubmit);
    document.getElementById('editForm').addEventListener('submit', handleEditSubmit);

    // Close modals on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeCreateModal();
            closeEditModal();
        }
    });
</script>