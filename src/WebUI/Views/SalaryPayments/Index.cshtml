@{
    Layout = "_Layout";
    ViewData["Title"] = "دفعات الرواتب";
}

<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-xl gap-md">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs">دفعات الرواتب</h2>
        <p class="font-body-lg text-body-lg text-secondary">سجل كامل لدفعات رواتب الموظفين، بمبالغها وخصوماتها وحالتها.</p>
    </div>
</div>

<!-- Filters -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-md mb-gutter shadow-[0px_4px_20px_rgba(0,0,0,0.04)]">
    <div class="flex flex-wrap gap-md items-end">
        <div class="flex-1 min-w-[150px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">اسم الموظف</label>
            <input type="text" id="filterEmployeeName" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" placeholder="بحث بالاسم..." />
        </div>
        <div class="flex-1 min-w-[130px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">من تاريخ</label>
            <input type="date" id="filterFromDate" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" />
        </div>
        <div class="flex-1 min-w-[130px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">إلى تاريخ</label>
            <input type="date" id="filterToDate" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" />
        </div>
        <button class="px-md py-sm bg-primary-container text-on-primary-container rounded-lg font-label-md text-label-md hover:bg-inverse-primary transition-colors shadow-sm" onclick="loadSalaryPayments()">
            <span class="material-symbols-outlined text-[18px] align-middle">filter_list</span>
            تصفية
        </button>
    </div>
</div>

<!-- Payments Table -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.04)] overflow-hidden">
    <div class="p-md border-b border-outline-variant flex justify-between items-center bg-surface-container-low">
        <h4 class="font-title-lg text-title-lg text-on-surface">سجل دفعات الرواتب</h4>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse" id="salaryPaymentsTable">
            <thead>
                <tr class="bg-surface-container-highest/30">
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الموظف</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">تاريخ الدفع</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">تاريخ الاستحقاق</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الراتب</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الخصم</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">المبلغ المدفوع</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الحساب</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الحالة</th>
                </tr>
            </thead>
            <tbody id="salaryPaymentsBody" class="font-body-md text-body-md text-on-surface">
                <tr>
                    <td colspan="8" class="py-12 text-center text-secondary">جاري التحميل...</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="p-md border-t border-outline-variant flex justify-between items-center" id="paginationContainer" style="display:none;">
        <span class="font-label-md text-label-md text-secondary" id="paginationInfo"></span>
        <div class="flex gap-sm" id="paginationButtons"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/salary-payments.js" asp-append-version="true"></script>
}
