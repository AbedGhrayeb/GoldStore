@{
    ViewData["Title"] = "لوحة القيادة";
}


<!-- ── KPI CARDS ───────────────────────── -->
<section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">

    <!-- Card: سعر الذهب -->
    <div class="kpi-card">
        <div class="kpi-icon bg-amber-100 text-amber-700">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M12 7v10M15 9.5a3 3 0 00-3-2.5 3 3 0 100 5 3 3 0 010 5 3 3 0 01-3-2.5" /></svg>
        </div>
        <div class="flex-1 text-right">
            <p class="kpi-label">سعر الذهب (عيار 21 / جم)</p>
            <p class="kpi-value"><span id="goldPriceValue" class="font-data-mono">—</span> <span class="kpi-unit" id="goldPriceUnit"></span></p>
            <div id="goldPriceChange"></div>
        </div>
    </div>

    <!-- Card: معادل عيار 21 -->
    <div class="kpi-card">
        <div class="kpi-icon bg-primary-cont text-on-primary-cont">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
        </div>
        <div class="flex-1 text-right">
            <p class="kpi-label">معادل عيار 21</p>
            <p class="kpi-value"><span id="goldWeightValue" class="font-data-mono">—</span> <span class="kpi-unit" id="goldWeightUnit"></span></p>
            <p class="text-xs text-secondary mt-0.5" id="goldWeightSub"></p>
        </div>
    </div>

    <!-- Card: أرصدة النقدية -->
    <div class="kpi-card">
        <div class="kpi-icon bg-blue-100 text-blue-600">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" /></svg>
        </div>
        <div class="flex-1 text-right">
            <p class="kpi-label">أرصدة النقدية</p>
            <div id="cashBalanceRows" class="mt-1 flex flex-col gap-1"></div>
        </div>
    </div>

    <!-- Card: أرصدة البنوك -->
    <div class="kpi-card">
        <div class="kpi-icon bg-green-100 text-green-600">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3m4-3v3m4-3v3" /></svg>
        </div>
        <div class="flex-1 text-right">
            <p class="kpi-label">أرصدة البنوك</p>
            <div id="bankBalanceRows" class="mt-1 flex flex-col gap-1"></div>
        </div>
    </div>

</section>

<!-- ── CHART + STATS ROW ──────────────── -->
<section class="grid grid-cols-1 lg:grid-cols-5 gap-4">

    <!-- Gold Inventory Trend (spans 3 cols on lg) -->
    <div class="lg:col-span-3 card">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
            <h2 class="section-title">مخزون الذهب (معادل عيار 21)</h2>
            <div class="flex gap-1.5" id="trendTabs">
                <button type="button" class="tab-btn active" data-period="week">أسبوع</button>
                <button type="button" class="tab-btn" data-period="month">شهر</button>
            </div>
        </div>
        <div class="relative h-52 sm:h-64">
            <canvas id="goldTrendChart"></canvas>
        </div>
    </div>

    <!-- Today's Employee Stats (spans 2 cols on lg) -->
    <div class="lg:col-span-2 card flex flex-col gap-4">
        <h2 class="section-title">إحصائيات اليوم</h2>
        <div id="employeeStats" class="flex flex-col gap-3"></div>
    </div>

</section>

<!-- ── RECENT TRANSACTIONS ────────────── -->
<section class="card">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <h2 class="section-title">أحدث الحركات المالية</h2>
        <a asp-controller="FinancialTransactions" asp-action="Index" class="text-sm text-primary hover:underline flex items-center gap-1">
            عرض الكل
            <svg class="w-3.5 h-3.5 rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
    </div>

    <!-- Table wrapper: scroll on mobile -->
    <div class="overflow-x-auto -mx-4 lg:-mx-6 px-4 lg:px-6">
        <table class="w-full min-w-[640px] text-sm">
            <thead>
                <tr class="border-b border-outline-variant text-secondary text-right">
                    <th class="pb-2.5 font-medium">التاريخ</th>
                    <th class="pb-2.5 font-medium">النوع</th>
                    <th class="pb-2.5 font-medium">الحساب</th>
                    <th class="pb-2.5 font-medium">المبلغ</th>
                    <th class="pb-2.5 font-medium">الاتجاه</th>
                </tr>
            </thead>
            <tbody id="recent-transactions-body" class="divide-y divide-outline-variant/50">
                <!-- Rows injected by JS -->
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script src="~/js/gold-prices.js" asp-append-version="true"></script>
    <script src="~/js/home.js" asp-append-version="true"></script>
}
