@{
    ViewData["Title"] = "لوحة القيادة";
}


<!-- ── KPI CARDS ───────────────────────── -->
<section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">

    <!-- Card: إجمالي رصيد الذهب -->
    <div class="kpi-card">
        <div class="kpi-icon bg-primary-cont text-on-primary-cont">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l2 7h7l-5.5 4 2 7L12 16l-5.5 4 2-7L3 9h7z" /></svg>
        </div>
        <div class="flex-1 text-right">
            <p class="kpi-label">إجمالي رصيد الذهب</p>
            <p class="kpi-value">4,520 <span class="kpi-unit">جم</span></p>
        </div>
        <span class="badge-up">↑ 2.4%</span>
    </div>

    <!-- Card: معادل عيار 21 -->
    <div class="kpi-card">
        <div class="kpi-icon bg-amber-100 text-amber-700">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
        </div>
        <div class="flex-1 text-right">
            <p class="kpi-label">معادل عيار 21</p>
            <p class="kpi-value">3,980 <span class="kpi-unit">جم</span></p>
        </div>
    </div>

    <!-- Card: أرصدة النقدية -->
    <div class="kpi-card">
        <div class="kpi-icon bg-blue-100 text-blue-600">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" /></svg>
        </div>
        <div class="flex-1 text-right">
            <p class="kpi-label">أرصدة النقدية (JOD)</p>
            <p class="kpi-value">125,400 <span class="kpi-unit">د.أ</span></p>
            <p class="text-xs text-muted mt-0.5">ILS: ₪80K &nbsp;·&nbsp; USD: $45K</p>
        </div>
    </div>

    <!-- Card: أرصدة البنوك -->
    <div class="kpi-card">
        <div class="kpi-icon bg-green-100 text-green-600">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 14v3m4-3v3m4-3v3" /></svg>
        </div>
        <div class="flex-1 text-right">
            <p class="kpi-label">أرصدة البنوك</p>
            <p class="kpi-value">450,000 <span class="kpi-unit">د.أ</span></p>
        </div>
    </div>

</section>

<!-- ── CHART + STATS ROW ──────────────── -->
<section class="grid grid-cols-1 lg:grid-cols-5 gap-4">

    <!-- Gold Price Chart (spans 3 cols on lg) -->
    <div class="lg:col-span-3 card">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
            <h2 class="section-title">مؤشر أسعار الذهب</h2>
            <div class="flex gap-1.5">
                <button class="tab-btn active" data-period="day">اليوم</button>
                <button class="tab-btn" data-period="week">أسبوع</button>
                <button class="tab-btn" data-period="month">شهر</button>
            </div>
        </div>
        <div class="relative h-52 sm:h-64">
            <canvas id="goldChart"></canvas>
        </div>
    </div>

    <!-- Today's Stats (spans 2 cols on lg) -->
    <div class="lg:col-span-2 card flex flex-col gap-4">
        <h2 class="section-title">إحصائيات اليوم</h2>

        <!-- Sales -->
        <div>
            <div class="flex justify-between items-center mb-1.5">
                <span class="stat-label">مبيعات اليوم</span>
                <span class="stat-value text-gold font-semibold">150 جم</span>
            </div>
            <div class="progress-track">
                <div class="progress-bar bg-gold" style="width: 75%"></div>
            </div>
        </div>

        <!-- Purchases -->
        <div>
            <div class="flex justify-between items-center mb-1.5">
                <span class="stat-label">مشتريات الذهب</span>
                <span class="stat-value text-gray-500 font-semibold">80 جم</span>
            </div>
            <div class="progress-track">
                <div class="progress-bar bg-gray-400" style="width: 40%"></div>
            </div>
        </div>

        <!-- Divider -->
        <div class="border-t border-outline-var pt-3 mt-auto">
            <p class="stat-label text-right">أجور التصنيع المستحقة</p>
            <p class="text-xl font-bold text-on-surface text-right mt-1">4,200 <span class="text-sm font-normal text-muted">د.أ</span></p>
        </div>
    </div>

</section>

<!-- ── RECENT TRANSACTIONS ────────────── -->
<section class="card">
    <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
        <h2 class="section-title">أحدث العمليات</h2>
        <a href="#" class="text-sm text-gold hover:underline flex items-center gap-1">
            عرض الكل
            <svg class="w-3.5 h-3.5 rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
    </div>

    <!-- Table wrapper: scroll on mobile -->
    <div class="overflow-x-auto -mx-4 lg:-mx-6 px-4 lg:px-6">
        <table class="w-full min-w-[640px] text-sm">
            <thead>
                <tr class="border-b border-outline-var text-muted text-right">
                    <th class="pb-2.5 font-medium">رقم المرجع</th>
                    <th class="pb-2.5 font-medium">النوع</th>
                    <th class="pb-2.5 font-medium">العميل / المورد</th>
                    <th class="pb-2.5 font-medium">الوزن (جم)</th>
                    <th class="pb-2.5 font-medium">القيمة</th>
                    <th class="pb-2.5 font-medium">التاريخ</th>
                    <th class="pb-2.5 font-medium">الحالة</th>
                </tr>
            </thead>
            <tbody id="tx-table-body" class="divide-y divide-outline-var/50">
                <!-- Rows injected by JS -->
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
}