@model LoginModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "_IdentityLayout";

}
<!-- Right Side: Login Form (Primary Interaction in RTL) -->
<section class="w-full md:w-[450px] lg:w-[500px] flex-shrink-0 bg-surface-container-lowest flex flex-col justify-center px-8 md:px-12 lg:px-16 z-20 shadow-[0px_4px_20px_rgba(0,0,0,0.04)] relative">
    <!-- Brand Logo -->
    <div class="mb-10 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-primary-container flex items-center justify-center text-on-primary-container">
            <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: &quot;FILL&quot; 1;">diamond</span>
        </div>
        <span class="font-title-lg text-title-lg font-bold text-primary">مجوهرات سرحان</span>
    </div>
    <!-- Welcome Text -->
    <div class="mb-8">
        <h1 class="font-headline-md text-headline-md font-bold text-on-surface mb-2">مرحباً بك مجدداً</h1>
        <p class="font-body-md text-body-md text-secondary">الرجاء إدخال بيانات الاعتماد للوصول إلى لوحة التحكم.</p>
    </div>
    <!-- Form -->
    <form class="flex flex-col gap-5" method="POST">
        <!-- Email Field -->
        <div>
            <label class="block font-label-md text-label-md text-on-surface-variant mb-2" for="email">البريد الإلكتروني</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute right-4 text-secondary">mail</span>
                <input class="w-full bg-surface text-on-surface border border-outline-variant rounded-lg pl-4 pr-12 py-3 font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow text-left placeholder:text-secondary-fixed-dim" dir="ltr" asp-for="Username" placeholder="name@company.com" type="email">
            </div>
        </div>
        <!-- Password Field -->
        <div>
            <div class="flex justify-between items-center mb-2">
                <label class="block font-label-md text-label-md text-on-surface-variant" for="password">كلمة المرور</label>
                <a class="font-label-md text-label-md text-primary hover:text-primary-fixed-dim transition-colors" href="#">نسيت كلمة المرور؟</a>
            </div>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute right-4 text-secondary">lock</span>
                <input class="w-full bg-surface text-on-surface border border-outline-variant rounded-lg pl-4 pr-12 py-3 font-body-md text-body-md focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow text-left placeholder:text-secondary-fixed-dim" dir="ltr" asp-for="Password" placeholder="••••••••" type="password">
                <button class="absolute left-4 text-secondary hover:text-on-surface transition-colors flex items-center justify-center" type="button">
                    <span class="material-symbols-outlined">visibility_off</span>
                </button>
            </div>
        </div>
        <!-- Primary Submit -->
        <button class="mt-2 w-full bg-primary-container text-on-primary-container hover:bg-primary-fixed-dim font-label-md text-label-md py-3 px-4 rounded-lg transition-colors flex justify-center items-center gap-2 shadow-sm" type="submit">
            <span class="">تسجيل الدخول</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </button>
    </form>
    <!-- Divider -->
    <div class="my-8 flex items-center gap-4">
        <div class="flex-1 h-px bg-outline-variant opacity-50"></div>

        <div class="flex-1 h-px bg-outline-variant opacity-50"></div>
    </div>
    <!-- Alternative Logins -->
    <div class="flex flex-col gap-3">
    </div>
</section>
<!-- Left Side: Atmospheric & Data Section (Hidden on mobile) -->
<section class="hidden md:flex flex-1 relative bg-surface-container overflow-hidden">
    <!-- Atmospheric Background Image with Overlay -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" data-alt="A macro, high-resolution photograph of textured, molten gold swirling elegantly against a stark, pure white background. The lighting is incredibly soft and high-key, creating a modern, minimalist, and luxurious aesthetic suitable for a high-end corporate financial platform. Subtle reflections gleam on the metallic surface, emphasizing value and precision without being overly dark or moody." style="background-image: url(&quot;https://lh3.googleusercontent.com/aida-public/AB6AXuB0XtxG_dXHk99xmIiQXJdTrSLtQ3PmK1lxDzW67HZLRn6VaEa7Uj45YZyPQ6hgImXVabLb1vSikWmmsPUWl6ILbvgBNzgFMoneS35cSgv0zXGR29QLTBYOek1r2SvbsBXmjs-FMqHCnRlzHTLjAsYCCvV9V5BCMFsR398K9oR2NzG-7O9TOADan-4YoTNskRFhKNSBMPgZ4X9tomfoBSKXvwDiRr4A6aGWxvbz7G4UI-OanWUPsypLo7wxFaiFyZ5unqdyBztp1Ck&quot;);">
    </div>
    <div class="absolute inset-0 bg-surface/60 backdrop-blur-[2px]"></div>
    <!-- Content Container -->
    <div class="relative z-10 w-full h-full flex flex-col justify-center items-center p-12">
        <!-- Glassmorphism Panel for Live Data -->
        <div class="w-full max-w-xl bg-surface-container-lowest/80 backdrop-blur-xl border border-outline-variant/50 rounded-xl p-8 shadow-[0px_10px_32px_rgba(0,0,0,0.08)]">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="font-headline-md text-headline-md font-bold text-on-surface">مؤشرات السوق الحية</h2>
                    <p class="font-body-md text-body-md text-secondary mt-1">تحديث مباشر لأسعار الذهب العالمية</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center border border-outline-variant">
                    <span class="material-symbols-outlined text-primary text-[24px]">trending_up</span>
                </div>
            </div>
            <!-- Bento Grid for Prices -->
            <div class="grid grid-cols-2 gap-4" id="loginKpiGrid">
                <div class="bg-surface p-5 rounded-lg border border-outline-variant col-span-2 flex items-center justify-center py-12 text-secondary">
                    جاري تحميل الأسعار...
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/js/gold-prices.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', async function () {
        // Gold prices: cached in localStorage for 1 day
        // Inventory KPIs: fresh from the DB on every page load
        const [gold, inv] = await Promise.all([loadGoldPrices(), loadInventoryKpis()]);
        if (!gold && !inv) return;

        const grid = document.getElementById('loginKpiGrid');
        if (!grid) return;

        const cards = [];

        if (gold?.pricePerGram24K) {
            cards.push(buildLoginCard('عيار 24', gold.pricePerGram24K.displayPrice, gold.pricePerGram24K.changePercent24H, gold.pricePerGram24K.changeDirection, 'bg-primary-container'));
        }
        if (gold?.pricePerGram21K) {
            cards.push(buildLoginCard('عيار 21', gold.pricePerGram21K.displayPrice, gold.pricePerGram21K.changePercent24H, gold.pricePerGram21K.changeDirection, 'bg-outline'));
        }

        if (inv?.totalEquivalent21KDisplay) {
            cards.push(buildLoginStockCard('إجمالي المخزون', inv.totalEquivalent21KDisplay, inv.totalEquivalent21KUnit || 'جم', inv.estimatedValueDisplay));
        }

        if (gold?.spotPrice) {
            cards.push(buildLoginCard('السعر العالمي (أونصة)', gold.spotPrice.displayPrice, gold.spotPrice.changePercent24H, gold.spotPrice.changeDirection, 'bg-primary-container'));
        }

        grid.innerHTML = cards.join('');
    });

    function buildLoginCard(label, price, change, direction, dotClass) {
        return '<div class="bg-surface p-5 rounded-lg border border-outline-variant hover:border-primary/50 transition-colors">' +
            '<div class="flex items-center gap-2 mb-3">' +
                '<span class="w-2 h-2 rounded-full ' + dotClass + '"></span>' +
                '<span class="font-label-md text-label-md text-on-surface-variant">' + label + '</span>' +
            '</div>' +
            '<div class="flex items-baseline gap-1">' +
                '<span class="font-display-lg text-display-lg font-bold text-on-surface">' + (price || '—') + '</span>' +
                '<span class="font-label-md text-label-md text-secondary">د.أ / جم</span>' +
            '</div>' +
            renderGoldPriceChange(change, direction) +
        '</div>';
    }

    function buildLoginStockCard(label, totalGrams, unit, estimatedValue) {
        return '<div class="bg-surface p-5 rounded-lg border border-outline-variant hover:border-primary/50 transition-colors">' +
            '<div class="flex items-center gap-2 mb-3">' +
                '<span class="w-2 h-2 rounded-full bg-primary-container"></span>' +
                '<span class="font-label-md text-label-md text-on-surface-variant">' + label + '</span>' +
            '</div>' +
            '<div class="flex items-baseline gap-1">' +
                '<span class="font-display-lg text-display-lg font-bold text-on-surface">' + (totalGrams || '0.000') + '</span>' +
                '<span class="font-label-md text-label-md text-secondary">' + (unit || 'جم') + ' (عيار 21)</span>' +
            '</div>' +
            '<div class="mt-2 flex items-center gap-1 text-secondary">' +
                '<span class="font-data-mono text-data-mono text-sm">القيمة: ' + (estimatedValue || '—') + ' د.أ</span>' +
            '</div>' +
        '</div>';
    }
</script>
