@using Domain.Employees
@model WebUI.Models.Employee.EditEmployeeModel
@{
    Layout = null;
}
<form asp-action="Edit" asp-controller="Employees" method="post" class="ajaxForm space-y-5">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="flex items-center justify-between p-4 sm:p-6 border-b border-outline-variant">
        <h2 class="text-lg sm:text-xl font-bold text-on-surface">تعديل الموظف</h2>
        <button type="button" class="p-2 hover:bg-gray-100 rounded-lg transition-colors" onclick="closeModal()">
            <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>
    <div class="p-4 sm:p-6">
        <div>
            <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-2">اسم الموظف *</label>
            <input asp-for="FirstName" class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors" placeholder="أدخل اسم الموظف" />
            <span asp-validation-for="FirstName" class="text-danger text-sm mt-1 invalid-feedback"></span>
        </div>
        <div class="mt-4">
            <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-2">اسم العائلة *</label>
            <input asp-for="LastName" class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors" placeholder="أدخل اسم العائلة" />
            <span asp-validation-for="LastName" class="text-danger text-sm mt-1 invalid-feedback"></span>
        </div>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label asp-for="Role" class="block text-sm font-medium text-gray-700 mb-2">الدور *</label>
                <select asp-for="Role" class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors">
                    <option value="">-- اختر الدور --</option>
                    @foreach (RoleEnum role in Enum.GetValues<RoleEnum>())
                    {
                        <option value="@((int)role)">@role.ToFriendlyString()</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-danger text-sm mt-1 invalid-feedback"></span>
            </div>
            <div>
                <label asp-for="SalaryCycle" class="block text-sm font-medium text-gray-700 mb-2">دورة الراتب *</label>
                <select asp-for="SalaryCycle" class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors">
                    <option value="">-- اختر دورة الراتب --</option>
                    @foreach (SalaryCycleEnum cycle in Enum.GetValues<SalaryCycleEnum>())
                    {
                        <option value="@((int)cycle)">@cycle.ToFriendlyString()</option>
                    }
                </select>
                <span asp-validation-for="SalaryCycle" class="text-danger text-sm mt-1 invalid-feedback"></span>
            </div>
        </div>
        <div class="mt-4">
            <label asp-for="Salary" class="block text-sm font-medium text-gray-700 mb-2">الراتب *</label>
            <input asp-for="Salary" type="number" step="0.001" min="0.001" dir="ltr"
                   class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors data-mono" placeholder="مثال: 500" />
            <span asp-validation-for="Salary" class="text-danger text-sm mt-1 invalid-feedback"></span>
        </div>

        @if (Model.UserId.HasValue)
        {
            <div class="mt-4 bg-surface-container rounded-lg border border-outline-variant p-3 flex items-center justify-between">
                <span class="text-sm font-medium text-gray-700">حساب المستخدم المرتبط</span>
                <span class="text-sm text-on-surface data-mono" dir="ltr">@Model.UserEmail</span>
            </div>
        }
        else
        {
            <div class="mt-4 bg-surface-container rounded-lg border border-outline-variant p-3 flex items-center justify-between">
                <span class="text-sm font-medium text-gray-700">حساب المستخدم</span>
                <span class="text-sm text-secondary">غير مرتبط</span>
            </div>
        }

        <div class="flex items-center gap-3 mt-4">
            <input type="checkbox" asp-for="IsActive" class="w-4 h-4 text-gold border-gray-300 rounded focus:ring-gold" />
            <label asp-for="IsActive" class="text-sm font-medium text-gray-700">نشط</label>
        </div>

        <div class="flex gap-3 pt-6">
            <button type="button" class="flex-1 px-6 py-2.5 border border-gray-200 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors" onclick="closeModal()">إلغاء</button>
            <button type="submit" class="flex-1 px-6 py-2.5 bg-primary hover:bg-gold/90 text-white rounded-lg font-medium transition-colors">حفظ التغييرات</button>
        </div>
    </div>
</form>
