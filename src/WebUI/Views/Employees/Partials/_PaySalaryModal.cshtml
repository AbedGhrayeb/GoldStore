@using Domain.Employees
@using Application.Finance.Accounts
@model WebUI.Models.Employee.PaySalaryModel
@{
    Layout = null;
    var employee = ViewBag.Employee as Application.Employees.EmployeeResponse;
    var scheduledDate = (DateOnly)ViewBag.ScheduledDate;
    var accounts = ViewBag.Accounts as List<AccountWithBalanceResponse> ?? [];
    var salary = employee?.Salary ?? 0m;
    var salaryCycle = employee?.SalaryCycle ?? SalaryCycleEnum.Monthly;
    var alreadyPaid = (decimal)ViewBag.AlreadyPaid;
    var discountAmount = (decimal)ViewBag.DiscountAmount;
    var netAmount = (decimal)ViewBag.NetAmount;
    var remaining = (decimal)ViewBag.Remaining;
}
<form asp-action="PaySalaryAjax" asp-controller="Employees" method="post"
      class="ajaxForm space-y-5" id="paySalaryForm"
      data-salary="@salary"
      data-cycle="@((int)salaryCycle)">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="EmployeeId" />
    <div class="flex items-center justify-between p-4 sm:p-6 border-b border-outline-variant">
        <h2 class="text-lg sm:text-xl font-bold text-on-surface">دفع راتب</h2>
        <button type="button" class="p-2 hover:bg-gray-100 rounded-lg transition-colors" onclick="closeModal()">
            <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>
    <div class="p-4 sm:p-6">
        <!-- Employee Summary -->
        <div class="rounded-lg bg-surface-container/50 border border-outline-variant p-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="font-semibold text-on-surface">@employee?.FullName</div>
                    <div class="text-secondary text-xs mt-0.5">@employee?.RoleName • @employee?.SalaryCycleName</div>
                </div>
                <div class="text-left">
                    <div class="text-secondary text-xs">الراتب الأساسي</div>
                    <div class="data-mono text-on-surface" dir="ltr">@salary.ToString("N3") @employee?.CurrencySymbol</div>
                </div>
            </div>
        </div>

        <!-- Account -->
        <div class="mt-4">
            <label asp-for="AccountId" class="block text-sm font-medium text-gray-700 mb-2">حساب الدفع *</label>
            <select asp-for="AccountId" class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors">
                <option value="">-- اختر الحساب --</option>
                @foreach (var account in accounts)
                {
                    <option value="@account.Id">@account.Name (@account.Currency) — الرصيد @account.Balance.ToString("N3")</option>
                }
            </select>
            <span asp-validation-for="AccountId" class="text-danger text-sm mt-1 invalid-feedback"></span>
            <p class="text-secondary text-xs mt-1">تُعرض الحسابات بعملة الراتب: <span class="data-mono" dir="ltr">@employee?.Currency (@employee?.CurrencySymbol)</span></p>
        </div>

        <!-- Payment Date -->
        <div class="mt-4">
            <label asp-for="PaymentDate" class="block text-sm font-medium text-gray-700 mb-2">تاريخ الدفع *</label>
            <input asp-for="PaymentDate" type="date" dir="ltr" onchange="recalcPaymentSummary()"
                   class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors" />
            <span asp-validation-for="PaymentDate" class="text-danger text-sm mt-1 invalid-feedback"></span>
        </div>

        <!-- Live Summary -->
        <div class="mt-4 rounded-lg border border-outline-variant p-4 space-y-2 bg-surface-container-lowest">
            <div class="flex items-center justify-between text-sm">
                <span class="text-secondary">تاريخ الاستحقاق</span>
                <span class="data-mono text-on-surface" id="sumScheduled" dir="ltr">@scheduledDate.ToString("yyyy-MM-dd")</span>
            </div>
            <div class="flex items-center justify-between text-sm" id="discountRow" style="display:none">
                <span class="text-secondary">أيام الانحراف عن تاريخ الاستحقاق</span>
                <span class="data-mono text-red-600" id="sumDayOff"></span>
            </div>
            <div class="flex items-center justify-between text-sm" id="discountRow2" style="display:none">
                <span class="text-secondary">قيمة الخصم (نسبة @SalaryPayment.DiscountRatePercentPerDay% لكل يوم)</span>
                <span class="data-mono text-red-600" id="sumDiscount" dir="ltr">0.000</span>
            </div>
            <div class="flex items-center justify-between border-t border-outline-variant pt-2">
                <span class="font-medium text-on-surface">صافي الراتب</span>
                <span class="data-mono text-on-surface" id="sumNet" dir="ltr">@netAmount.ToString("N3")</span>
            </div>
            <div class="flex items-center justify-between text-sm">
                <span class="text-secondary">المدفوع لهذه الفترة</span>
                <span class="data-mono text-secondary" id="sumPaid" dir="ltr">@alreadyPaid.ToString("N3")</span>
            </div>
            <div class="flex items-center justify-between text-sm">
                <span class="font-medium text-on-surface">المتبقي المستحق</span>
                <span class="data-mono text-primary text-base" id="sumRemaining" dir="ltr">@remaining.ToString("N3")</span>
            </div>
        </div>

        <!-- Amount -->
        <div class="mt-4">
            <label asp-for="Amount" class="block text-sm font-medium text-gray-700 mb-2">مبلغ الدفعة *</label>
            <input asp-for="Amount" type="number" step="0.001" min="0.001" dir="ltr" id="payAmount"
                   class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors data-mono" />
            <span asp-validation-for="Amount" class="text-danger text-sm mt-1 invalid-feedback"></span>
            <p class="text-secondary text-xs mt-1">يمكن دفع الراتب على دفعة واحدة أو أكثر، ويسدد الخصم من الراتب الأساسي.</p>
        </div>

        <!-- Notes -->
        <div class="mt-4">
            <label asp-for="Notes" class="block text-sm font-medium text-gray-700 mb-2">ملاحظات</label>
            <textarea asp-for="Notes" rows="2"
                      class="form-control w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-gold/20 focus:border-gold transition-colors"
                      placeholder="اختياري"></textarea>
            <span asp-validation-for="Notes" class="text-danger text-sm mt-1 invalid-feedback"></span>
        </div>

        <div class="flex gap-3 pt-6">
            <button type="button" class="flex-1 px-6 py-2.5 border border-gray-200 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors" onclick="closeModal()">إلغاء</button>
            <button type="submit" class="flex-1 px-6 py-2.5 bg-primary hover:bg-gold/90 text-white rounded-lg font-medium transition-colors">دفع الراتب</button>
        </div>
    </div>
</form>
