@{
    Layout = "_Layout";
    ViewData["Title"] = "إدارة الموظفين";
}

<link rel="stylesheet" href="~/css/employees.css" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.04)] flex flex-col h-full">
    @Html.AntiForgeryToken()

    <!-- Header -->
    <div class="p-4 border-b border-outline-variant flex justify-between items-center bg-surface-container-low/50">
        <div>
            <h2 class="text-xl font-bold text-on-surface">إدارة الموظفين</h2>
            <p class="text-secondary text-sm mt-1">قائمة بجميع موظفي المتجر</p>
        </div>
        <a asp-action="AddOrUpdate" asp-controller="Employees" ajaxType="GET" title="إضافة موظف جديد"
           class="openModal bg-primary-container text-on-primary px-4 py-2 rounded-lg font-medium flex items-center gap-2 hover:bg-primary transition-colors cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            إضافة موظف
        </a>
    </div>

    <!-- Filter Tabs & Search -->
    <div class="p-3 border-b border-outline-variant flex gap-2 bg-surface items-center flex-wrap">
        <button class="filter-tab active" data-count-type="all" onclick="filterEmployees('all')">الكل (<span id="countAll">0</span>)</button>
        <button class="filter-tab" data-count-type="active" onclick="filterEmployees('active')">نشط (<span id="countActive">0</span>)</button>
        <button class="filter-tab" data-count-type="stopped" onclick="filterEmployees('stopped')">متوقف (<span id="countStopped">0</span>)</button>
        <div class="flex-1"></div>
        <div class="relative w-64">
            <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-secondary pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text" id="employeeSearch" placeholder="البحث عن موظف..."
                   class="w-full pr-9 pl-3 py-2 bg-surface-container-lowest border border-outline rounded-lg text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/30"
                   oninput="searchEmployees()" />
        </div>
    </div>

    <!-- Desktop Table -->
    <div class="hidden lg:block flex-1 overflow-y-auto">
        <table class="employee-table">
            <thead>
                <tr>
                    <th class="text-right">الموظف</th>
                    <th class="text-right">الدور</th>
                    <th class="text-right">الراتب</th>
                    <th class="text-right">آخر دفعة</th>
                    <th class="text-right">حساب المستخدم</th>
                    <th class="text-right">الحالة</th>
                    <th class="text-right">الإجراءات</th>
                </tr>
            </thead>
            <tbody id="employeesTableBody">
                <tr>
                    <td colspan="7" class="text-center py-12 text-secondary">جاري التحميل...</td>
                </tr>
            </tbody>
        </table>
        <div id="emptyStateDesktop" class="hidden text-center py-12">
            <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <p class="text-secondary">لا يوجد موظفون</p>
            <a asp-action="AddOrUpdate" asp-controller="Employees" ajaxType="GET" title="إضافة موظف جديد"
               class="openModal text-gold hover:underline mt-2 cursor-pointer">إضافة موظف جديد</a>
        </div>
    </div>

    <!-- Mobile Cards -->
    <div class="lg:hidden flex-1 overflow-y-auto p-4 space-y-3" id="employeesCards">
        <div class="text-center py-12 text-secondary">جاري التحميل...</div>
    </div>
    <div id="emptyStateMobile" class="hidden text-center py-12 lg:hidden">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <p class="text-secondary">لا يوجد موظفون</p>
        <a asp-action="AddOrUpdate" asp-controller="Employees" ajaxType="GET" title="إضافة موظف جديد"
           class="openModal text-gold hover:underline mt-2 block mx-auto cursor-pointer">إضافة موظف جديد</a>
    </div>

    <!-- No Results -->
    <div id="noResults" class="hidden text-center py-12">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <p class="text-secondary">لا توجد نتائج مطابقة للبحث</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/employees.js" asp-append-version="true"></script>
}
