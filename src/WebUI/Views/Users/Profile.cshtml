@model WebUI.Models.User.EditUserModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "ملفي الشخصي";
    ViewData["ActivePage"] = "profile";
}

<link rel="stylesheet" href="~/css/profile.css" />

<div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="mb-xl">
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs">ملفي الشخصي</h2>
        <p class="font-body-lg text-body-lg text-secondary">عرض وتعديل بياناتك الشخصية.</p>
    </div>

    <!-- Profile Card -->
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.04)] overflow-hidden mb-gutter">
        <div class="p-md border-b border-outline-variant bg-surface-container-low flex items-center gap-md">
            <div class="w-16 h-16 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container font-bold text-2xl">
                @(Model.FirstName.Length > 0 ? Model.FirstName.Substring(0, 1) : "?")
            </div>
            <div>
                <p class="font-title-lg text-title-lg text-on-surface">@Model.FirstName @Model.LastName</p>
                <p class="font-body-md text-body-md text-secondary font-data-mono" dir="ltr">@Model.Email</p>
            </div>
        </div>
        <div class="p-md">
            <div class="grid grid-cols-2 gap-md">
                <div>
                    <span class="font-label-md text-label-md text-secondary">الاسم الأول</span>
                    <p class="font-body-lg text-body-lg text-on-surface mt-xs">@Model.FirstName</p>
                </div>
                <div>
                    <span class="font-label-md text-label-md text-secondary">اسم العائلة</span>
                    <p class="font-body-lg text-body-lg text-on-surface mt-xs">@Model.LastName</p>
                </div>
                <div>
                    <span class="font-label-md text-label-md text-secondary">البريد الإلكتروني</span>
                    <p class="font-body-lg text-body-lg text-on-surface mt-xs font-data-mono" dir="ltr">@Model.Email</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Form -->
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.04)] overflow-hidden">
        <div class="p-md border-b border-outline-variant bg-surface-container-low">
            <h4 class="font-title-lg text-title-lg text-on-surface">تعديل البيانات</h4>
        </div>
        <form id="profileForm" class="p-md space-y-md" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" id="editId" name="Id" value="@Model.Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">الاسم الأول</label>
                    <input type="text" id="editFirstName" name="FirstName" required
                           class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm"
                           value="@Model.FirstName" />
                    <p id="editFirstNameError" class="text-xs text-error hidden mt-xs"></p>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">اسم العائلة</label>
                    <input type="text" id="editLastName" name="LastName" required
                           class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm"
                           value="@Model.LastName" />
                    <p id="editLastNameError" class="text-xs text-error hidden mt-xs"></p>
                </div>
            </div>

           <div>
                <label class="font-label-md text-label-md text-secondary mb-xs block">كلمة المرور الجديدة</label>
                <input type="password" id="editPassword" name="Password"
                       class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm"
                       placeholder="اتركها فارغة إذا لم ترغب بتغييرها" dir="ltr" />
                <p class="text-xs text-secondary mt-xs">اتركها فارغة إذا لم ترغب بتغيير كلمة المرور</p>
                <p id="editPasswordError" class="text-xs text-error hidden mt-xs"></p>
            </div>

            <div id="editError" class="hidden bg-error/10 border border-error/30 rounded-lg p-sm">
                <p class="text-sm text-error" id="editErrorMessage"></p>
            </div>

            <div class="flex gap-sm pt-sm">
                <button type="submit"
                        class="flex-1 px-md py-sm bg-primary-container text-on-primary-container rounded-lg font-body-lg text-body-lg font-bold hover:bg-inverse-primary transition-colors shadow-sm">
                    حفظ التغييرات
                </button>
                <button type="button" onclick="resetForm()"
                        class="px-md py-sm bg-surface-container-lowest border border-outline-variant rounded-lg font-body-lg text-body-lg text-on-surface hover:bg-surface-container transition-colors shadow-sm">
                    إلغاء
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/profile.js" asp-append-version="true"></script>
}
