@{
    Layout = "_Layout";
    ViewData["Title"] = "دفعات المورد";
}

<link rel="stylesheet" href="~/css/supplier-payments.css" />
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

<div class="max-w-container-max mx-auto">
    <!-- Supplier Info & Balances -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-md mb-lg">
        <!-- Supplier Selection -->
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.04)] border border-surface-container flex flex-col justify-center">
            <label class="font-label-md text-label-md text-secondary mb-sm">اختيار المورد</label>
            <div class="relative">
                <select id="supplierSelect" class="w-full appearance-none bg-surface border border-outline-variant rounded-lg py-sm px-md pr-10 font-body-lg text-body-lg text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all" onchange="onSupplierSelected()">
                    <option value="">اختر مورد...</option>
                </select>
                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-secondary pointer-events-none">expand_more</span>
            </div>
        </div>

        <!-- Gold Balance KPI -->
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.04)] border border-surface-container relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-primary/5 rounded-full blur-xl group-hover:bg-primary/10 transition-all"></div>
            <div class="flex justify-between items-start relative z-10">
                <div>
                    <span class="font-label-md text-label-md text-secondary">رصيد الذهب (عيار 21)</span>
                    <div class="mt-xs flex items-baseline gap-xs">
                        <span class="font-display-lg text-display-lg text-on-surface" id="goldBalanceValue">—</span>
                        <span class="font-body-md text-body-md text-secondary">جم</span>
                    </div>
                    <span class="font-label-md text-label-md flex items-center gap-xs mt-sm" id="goldBalanceHint" style="display:none;">
                        <span class="material-symbols-outlined text-[16px]" id="goldBalanceArrow">arrow_downward</span>
                        <span id="goldBalanceLabel">مطلوب للدفع</span>
                    </span>
                </div>
                <div class="p-sm bg-primary-container/20 rounded-lg text-primary">
                    <span class="material-symbols-outlined icon-fill text-2xl">diamond</span>
                </div>
            </div>
        </div>

        <!-- Manufacturing Balance KPI -->
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.04)] border border-surface-container relative overflow-hidden group">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-tertiary-container/10 rounded-full blur-xl group-hover:bg-tertiary-container/20 transition-all"></div>
            <div class="flex justify-between items-start relative z-10">
                <div>
                    <span class="font-label-md text-label-md text-secondary">رصيد الأجور (التصنيع)</span>
                    <div class="mt-xs flex items-baseline gap-xs">
                        <span class="font-display-lg text-display-lg text-on-surface" id="mfgBalanceValue">—</span>
                        <span class="font-body-md text-body-md text-secondary" id="mfgBalanceCurrency">د.إ</span>
                    </div>
                    <span class="font-label-md text-label-md flex items-center gap-xs mt-sm" id="mfgBalanceHint" style="display:none;">
                        <span class="material-symbols-outlined text-[16px]" id="mfgBalanceArrow">arrow_downward</span>
                        <span id="mfgBalanceLabel">مطلوب للدفع</span>
                    </span>
                </div>
                <div class="p-sm bg-surface-container rounded-lg text-secondary">
                    <span class="material-symbols-outlined text-2xl">payments</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Forms Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-md mb-lg">
        <!-- Gold Scrap Payment -->
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.04)] border border-surface-container">
            <div class="flex items-center gap-sm mb-md pb-sm border-b border-surface-container">
                <span class="material-symbols-outlined text-primary">scale</span>
                <h2 class="font-title-lg text-title-lg text-on-surface">دفعة ذهب (كسر)</h2>
            </div>
            <form id="scrapGoldForm" class="space-y-md" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="scrapSupplierId" name="SupplierId" />
                <div class="grid grid-cols-2 gap-md">
                    <div>
                        <label class="font-label-md text-label-md text-secondary mb-xs block">الوزن</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 font-body-md text-secondary">جم</span>
                            <input type="number" id="scrapWeight" step="0.01" min="0.01" class="w-full bg-surface border border-outline-variant rounded-lg py-2 pl-10 pr-3 font-data-mono text-data-mono text-left focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" placeholder="0.00" oninput="calculateEquivalent21K()" />
                        </div>
                        <span class="text-xs text-error hidden" id="scrapWeightError">الوزن مطلوب</span>
                    </div>
                    <div>
                        <label class="font-label-md text-label-md text-secondary mb-xs block">العيار</label>
                        <select id="scrapKarat" class="w-full appearance-none bg-surface border border-outline-variant rounded-lg py-2 px-3 pr-10 font-body-lg text-body-lg focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" onchange="calculateEquivalent21K()">
                        </select>
                    </div>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">المكافئ (عيار 21)</label>
                    <input type="text" id="scrapEquiv21K" class="w-full bg-surface-container-low border border-surface-variant rounded-lg py-2 px-3 font-data-mono text-data-mono text-left text-secondary cursor-not-allowed" readonly value="0.00" />
                </div>
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">ملاحظات</label>
                    <input type="text" id="scrapNotes" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" placeholder="ملاحظات اختيارية..." />
                </div>
                <div class="pt-sm">
                    <button type="button" id="btnSubmitScrapGold" class="w-full bg-primary-container text-on-primary-container font-body-lg text-body-lg font-bold py-2 rounded-lg hover:bg-inverse-primary transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed" onclick="submitScrapGoldPayment()" disabled>
                        تسجيل دفعة ذهب
                    </button>
                </div>
            </form>
        </div>

        <!-- Manufacturing Payment -->
        <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.04)] border border-surface-container">
            <div class="flex items-center gap-sm mb-md pb-sm border-b border-surface-container">
                <span class="material-symbols-outlined text-secondary">account_balance</span>
                <h2 class="font-title-lg text-title-lg text-on-surface">دفعة أجور تصنيع</h2>
            </div>
            <form id="manufacturingForm" class="space-y-md" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="mfgSupplierId" name="SupplierId" />
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">المبلغ</label>
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <input type="number" id="mfgAmount" step="0.01" min="0.01" class="w-full bg-surface border border-outline-variant rounded-lg py-2 pl-3 pr-3 font-data-mono text-data-mono text-left focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" placeholder="0.00" />
                        </div>
                        <select id="mfgCurrency" class="w-24 appearance-none bg-surface-container border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md text-center focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all" onchange="filterAccountsByCurrency()">
                        </select>
                    </div>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">حساب الدفع</label>
                    <select id="mfgAccount" class="w-full appearance-none bg-surface border border-outline-variant rounded-lg py-2 px-3 pr-10 font-body-lg text-body-lg focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm">
                        <option value="">اختر حساب...</option>
                    </select>
                    <span class="text-xs text-error hidden" id="mfgAccountError">يجب اختيار حساب الدفع</span>
                </div>
                <div>
                    <label class="font-label-md text-label-md text-secondary mb-xs block">ملاحظات</label>
                    <input type="text" id="mfgNotes" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" placeholder="ملاحظات اختيارية..." />
                </div>
                <div class="pt-sm mt-[28px]">
                    <button type="button" id="btnSubmitManufacturing" class="w-full bg-inverse-surface text-on-secondary font-body-lg text-body-lg font-bold py-2 rounded-lg hover:bg-on-surface transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed" onclick="submitManufacturingPayment()" disabled>
                        تسجيل دفعة مالية
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Transaction History -->
    <div class="bg-surface-container-lowest rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.04)] border border-surface-container overflow-hidden">
        <div class="p-md border-b border-surface-container flex justify-between items-center bg-[#f8f7f5]">
            <h3 class="font-title-lg text-title-lg text-on-surface font-semibold">سجل الدفعات الأخيرة</h3>
            <button class="text-primary font-label-md text-label-md hover:underline" onclick="refreshSupplierData()" style="display:none;" id="btnViewAll">عرض الكل</button>
        </div>
        <!-- Tabs -->
        <div class="flex gap-xs px-md pt-sm border-b border-surface-container" id="transactionTabs">
            <button class="tx-tab active" onclick="switchTransactionTab('all', this)" data-tab="all">الكل</button>
            <button class="tx-tab" onclick="switchTransactionTab('ذهب', this)" data-tab="ذهب">ذهب</button>
            <button class="tx-tab" onclick="switchTransactionTab('تصنيع', this)" data-tab="تصنيع">أجور</button>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-right" id="transactionsTable">
                <thead>
                    <tr class="bg-surface-container-low border-b border-outline-variant">
                        <th class="py-3 px-4 font-label-md text-label-md text-secondary uppercase tracking-wider">التاريخ</th>
                        <th class="py-3 px-4 font-label-md text-label-md text-secondary uppercase tracking-wider">نوع الدفعة</th>
                        <th class="py-3 px-4 font-label-md text-label-md text-secondary uppercase tracking-wider text-left">الكمية / المبلغ</th>
                        <th class="py-3 px-4 font-label-md text-label-md text-secondary uppercase tracking-wider text-left">التفاصيل</th>
                        <th class="py-3 px-4 font-label-md text-label-md text-secondary uppercase tracking-wider text-center">الاتجاه</th>
                    </tr>
                </thead>
                <tbody id="transactionsBody">
                    <tr>
                        <td colspan="5" class="py-12 text-center text-secondary">اختر مورد لعرض الدفعات</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/supplier-payments.js" asp-append-version="true"></script>
}