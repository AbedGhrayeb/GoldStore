@{
    Layout = "_Layout";
    ViewData["Title"] = "عمليات المتجر";
    ViewData["ActivePage"] = "store-operations";
}

<link rel="stylesheet" href="~/css/store-operations.css" />

<!-- Header Section -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-xl gap-md">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-xs">عمليات المتجر</h2>
        <p class="font-body-lg text-body-lg text-secondary">سجل عمليات البيع والشراء في المتجر.</p>
    </div>
    <div class="flex gap-sm">
        <a asp-controller="SalesInvoices" asp-action="Index" class="flex items-center gap-xs px-md py-sm bg-surface-container-lowest border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container transition-colors shadow-sm">
            <span class="material-symbols-outlined text-[18px]">sell</span>
            فاتورة بيع
        </a>
        <a asp-controller="CustomerPurchaseInvoices" asp-action="Index" class="flex items-center gap-xs px-md py-sm bg-primary-container text-on-primary-container rounded-lg font-label-md text-label-md hover:bg-inverse-primary transition-colors shadow-sm">
            <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
            فاتورة شراء
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mb-xl">
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-md shadow-[0px_4px_20px_rgba(0,0,0,0.04)]">
        <div class="flex items-center gap-sm mb-xs">
            <span class="material-symbols-outlined text-primary text-xl">sell</span>
            <span class="font-label-md text-label-md text-secondary">مبيعات اليوم</span>
            <span class="font-label-md text-label-md text-on-surface mr-auto" id="kpiSalesCount">0 فاتورة</span>
        </div>
        <div id="kpiSalesTotals" class="space-y-xs"></div>
    </div>
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-md shadow-[0px_4px_20px_rgba(0,0,0,0.04)]">
        <div class="flex items-center gap-sm mb-xs">
            <span class="material-symbols-outlined text-primary text-xl">shopping_bag</span>
            <span class="font-label-md text-label-md text-secondary">مشتريات اليوم</span>
            <span class="font-label-md text-label-md text-on-surface mr-auto" id="kpiPurchasesCount">0 فاتورة</span>
        </div>
        <div id="kpiPurchasesTotals" class="space-y-xs"></div>
    </div>
</div>

<!-- Filters -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant p-md mb-gutter shadow-[0px_4px_20px_rgba(0,0,0,0.04)]">
    <div class="flex flex-wrap gap-md items-end">
        <div class="flex-1 min-w-[150px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">بحث</label>
            <input type="text" id="filterSearch" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" placeholder="رقم الفاتورة أو اسم الطرف..." />
        </div>
        <div class="flex-1 min-w-[130px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">من تاريخ</label>
            <input type="date" id="filterFromDate" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" />
        </div>
        <div class="flex-1 min-w-[130px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">إلى تاريخ</label>
            <input type="date" id="filterToDate" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm" />
        </div>
        <div class="flex-1 min-w-[120px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">نوع العملية</label>
            <select id="filterOperationType" class="w-full appearance-none bg-surface border border-outline-variant rounded-lg py-2 px-3 pr-10 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm">
                <option value="">الكل</option>
                <option value="Sale">بيع</option>
                <option value="Buy">شراء</option>
            </select>
        </div>
        <div class="flex-1 min-w-[150px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">الموظف</label>
            <select id="filterEmployeeName" class="w-full appearance-none bg-surface border border-outline-variant rounded-lg py-2 px-3 pr-10 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm">
                <option value="">الكل</option>
            </select>
        </div>
        <div class="flex-1 min-w-[150px]">
            <label class="font-label-md text-label-md text-secondary mb-xs block">الحساب</label>
            <select id="filterAccountId" class="w-full appearance-none bg-surface border border-outline-variant rounded-lg py-2 px-3 pr-10 font-body-md text-body-md focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all shadow-sm">
                <option value="">الكل</option>
            </select>
        </div>
        <button class="px-md py-sm bg-primary-container text-on-primary-container rounded-lg font-label-md text-label-md hover:bg-inverse-primary transition-colors shadow-sm" onclick="loadOperations()">
            <span class="material-symbols-outlined text-[18px] align-middle">filter_list</span>
            تصفية
        </button>
        <button class="px-md py-sm bg-surface-container-lowest border border-outline-variant rounded-lg font-label-md text-label-md text-on-surface hover:bg-surface-container transition-colors shadow-sm" onclick="resetFilters()">
            <span class="material-symbols-outlined text-[18px] align-middle">restart_alt</span>
            إعادة تعيين
        </button>
    </div>
</div>

<!-- Operations Table -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.04)] overflow-hidden">
    <div class="p-md border-b border-outline-variant flex justify-between items-center bg-surface-container-low">
        <h4 class="font-title-lg text-title-lg text-on-surface">سجل العمليات</h4>
        <span class="font-label-md text-label-md text-secondary" id="operationsCount"></span>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse" id="operationsTable">
            <thead>
                <tr class="bg-surface-container-highest/30">
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">التاريخ</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">رقم الفاتورة</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">النوع</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الطرف الآخر</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الموظف</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الحساب</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الإجمالي</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">المدفوع</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">المتبقي</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant">الحالة</th>
                    <th class="px-md py-3 font-label-md text-label-md text-secondary uppercase tracking-wider border-b border-outline-variant text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody id="operationsBody" class="font-body-md text-body-md text-on-surface">
                <tr>
                    <td colspan="11" class="py-12 text-center text-secondary">جاري التحميل...</td>
                </tr>
            </tbody>
        </table>
    </div>
    <!-- Pagination -->
    <div class="p-md border-t border-outline-variant flex justify-between items-center" id="paginationContainer" style="display:none;">
        <span class="font-label-md text-label-md text-secondary" id="paginationInfo"></span>
        <div class="flex gap-sm" id="paginationButtons"></div>
    </div>
</div>

<!-- Detail Modal -->
<div id="detailModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/50" onclick="closeDetail()"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-surface-container-lowest rounded-xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
            <div class="p-md border-b border-outline-variant flex justify-between items-center sticky top-0 bg-surface-container-lowest z-10">
                <div class="flex items-center gap-sm">
                    <h3 class="font-title-lg text-title-lg text-on-surface" id="detailTitle">تفاصيل العملية</h3>
                    <span id="detailTypeBadge"></span>
                </div>
                <button class="p-1 text-secondary hover:text-on-surface transition-colors" onclick="closeDetail()">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-md" id="detailContent">
                <p class="text-center text-secondary py-gutter">جاري التحميل...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/store-operations.js" asp-append-version="true"></script>
}
