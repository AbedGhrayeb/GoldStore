@{
    Layout = "_Layout";
    ViewData["Title"] = "إنشاء فاتورة مبيعات";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-sm mb-sm">
    <div>
        <h2 class="font-headline-md text-headline-md font-bold text-on-surface">إنشاء فاتورة مبيعات</h2>
        <p class="font-body-md text-body-md text-secondary mt-xs">رقم الفاتورة: <span id="invoiceNumber" class="font-data-mono">جاري التحميل...</span></p>
    </div>
    <div class="flex items-center gap-sm">
        <div class="bg-surface-container text-on-surface px-sm py-xs rounded-lg border border-outline-variant flex items-center gap-xs">
            <span class="material-symbols-outlined text-[18px]">calendar_today</span>
            <span id="invoiceDate" class="font-data-mono text-body-md"></span>
        </div>
        <div class="bg-primary-container/20 text-on-primary-container px-sm py-xs rounded-lg border border-primary-container flex items-center gap-xs">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            <span class="font-label-md text-label-md">جديد</span>
        </div>
    </div>
</div>

<!-- Main Grid Layout -->
<div class="grid grid-cols-1 xl:grid-cols-12 gap-md">
    <!-- Left/Main Content Area -->
    <div class="xl:col-span-8 flex flex-col gap-md">
        <!-- Customer DetaILS Card -->
        <section class="bg-surface-container-lowest rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.02)] border border-outline-variant/50 p-md">
            <div class="flex items-center justify-between mb-sm">
                <h3 class="font-title-lg text-title-lg font-bold text-on-surface flex items-center gap-xs">
                    <span class="material-symbols-outlined text-primary">person</span>
                    بيانات العميل
                </h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-sm">
                <div class="flex flex-col gap-xs">
                    <label class="font-label-md text-label-md text-secondary">اسم العميل</label>
                    <input class="bg-transparent border border-outline-variant rounded-lg px-sm py-2 font-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-shadow" id="customerName" placeholder="أدخل اسم العميل" type="text" />
                </div>
                <div class="flex flex-col gap-xs">
                    <label class="font-label-md text-label-md text-secondary">رقم الهاتف (اختياري)</label>
                    <input class="bg-transparent border border-outline-variant rounded-lg px-sm py-2 font-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-shadow" id="customerPhone" placeholder="05XX XXX XXXX" type="tel" />
                </div>
       </section>

        <!-- Items Table Card -->
        <section class="bg-surface-container-lowest rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.02)] border border-outline-variant/50 flex flex-col overflow-auto">
            <div class="p-md border-b border-outline-variant flex items-center justify-between bg-surface/50">
                <h3 class="font-title-lg text-title-lg font-bold text-on-surface flex items-center gap-xs">
                    <span class="material-symbols-outlined text-primary">shopping_bag</span>
                    عناصر الفاتورة
                </h3>
                <button class="bg-primary-container text-on-primary-container hover:bg-primary-fixed-dim font-label-md text-label-md px-sm py-xs rounded-lg transition-colors flex items-center gap-xs" onclick="addItemRow()">
                    <span class="material-symbols-outlined text-[18px]">add</span>
                    إضافة صنف
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-right border-collapse min-w-[700px]">
                    <thead class="bg-surface-container-low text-secondary font-label-md text-label-md sticky top-0">
                        <tr>
                            <th class="py-sm px-md border-b border-outline-variant">الصنف</th>
                            <th class="py-sm px-sm border-b border-outline-variant text-center w-20">العيار</th>
                            <th class="py-sm px-sm border-b border-outline-variant w-36">الوزن</th>
                            <th class="py-sm px-sm border-b border-outline-variant w-36">السعر للجرام</th>
                            <th class="py-sm px-md border-b border-outline-variant text-left w-32">الإجمالي</th>
                            <th class="py-sm px-sm border-b border-outline-variant w-12"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody" class="font-body-md text-on-surface">
                        <!-- Rows rendered by JS -->
                    </tbody>
                </table>
            </div>
            <!-- Totals Footer -->
            <div id="itemsSummary" class="bg-surface-container-low p-md border-t border-outline-variant flex items-center gap-md flex-wrap">
                <span class="font-body-md text-secondary">لم يتم إضافة أصناف بعد</span>
            </div>
        </section>
                <section class="bg-surface-container-lowest rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.02)] border border-outline-variant/50 p-md">
            <h3 class="font-title-lg text-title-lg font-bold text-on-surface flex items-center gap-xs mb-sm">
                <span class="material-symbols-outlined text-primary">badge</span>
                بيانات الموظف
            </h3>
            <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-secondary">اسم المشتري <span class="text-error">*</span></label>
     <select id="employeeSelect" class="bg-transparent border border-outline-variant rounded-lg px-sm py-2 font-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-shadow appearance-none">
                        <option value="">اختر الموظف</option>
                    </select>
            </div>
        </section>
        <!-- Payment Methods & Currency -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-md">
            <!-- Currency -->
            <div class="bg-surface-container-lowest rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.02)] border border-outline-variant/50 p-md flex flex-col gap-sm">
                <h3 class="font-label-md text-label-md font-bold text-secondary flex items-center gap-xs">
                    <span class="material-symbols-outlined text-[18px]">currency_exchange</span>
                    عملة الفاتورة
                    <span class="text-error">*</span>
                </h3>
                <div class="flex gap-sm">
                    <label class="flex-1 cursor-pointer">
                        <input checked class="peer sr-only" name="currency" type="radio" value="JOD" onchange="onCurrencyChange()">
                        <div class="border border-outline-variant rounded-lg py-2 text-center peer-checked:bg-primary-container peer-checked:text-on-primary-container peer-checked:border-primary-container hover:bg-surface-container-high transition-all font-data-mono">JOD</div>
                    </label>
                    <label class="flex-1 cursor-pointer">
                        <input class="peer sr-only" name="currency" type="radio" value="USD" onchange="onCurrencyChange()">
                        <div class="border border-outline-variant rounded-lg py-2 text-center peer-checked:bg-primary-container peer-checked:text-on-primary-container peer-checked:border-primary-container hover:bg-surface-container-high transition-all font-data-mono">USD</div>
                    </label>
                    <label class="flex-1 cursor-pointer">
                        <input class="peer sr-only" name="currency" type="radio" value="ILS" onchange="onCurrencyChange()">
                        <div class="border border-outline-variant rounded-lg py-2 text-center peer-checked:bg-primary-container peer-checked:text-on-primary-container peer-checked:border-primary-container hover:bg-surface-container-high transition-all font-data-mono">ILS</div>
                    </label>
                </div>
            </div>
            <!-- Payment Method -->
            <div class="bg-surface-container-lowest rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.02)] border border-outline-variant/50 p-md flex flex-col gap-sm">
                <h3 class="font-label-md text-label-md font-bold text-secondary flex items-center gap-xs">
                    <span class="material-symbols-outlined text-[18px]">payments</span>
                    طريقة الدفع
                    <span class="text-error">*</span>
                </h3>
                <div class="grid grid-cols-2 gap-sm">
                    <label class="cursor-pointer">
                        <input checked class="peer sr-only" name="paymentMethod" type="radio" value="1" onchange="onPaymentMethodChange()">
                        <span class="border border-outline-variant rounded-lg py-2 flex flex-col items-center justify-center gap-xs peer-checked:border-primary peer-checked:ring-1 peer-checked:ring-primary hover:bg-surface-container-high transition-all text-secondary peer-checked:text-primary">
                            <span class="material-symbols-outlined text-[20px]">money</span>
                            <span class="font-label-md text-[10px]">نقدي</span>
                        </span>
                    </label>
                    <label class="cursor-pointer">
                        <input class="peer sr-only" name="paymentMethod" type="radio" value="2" onchange="onPaymentMethodChange()">
                        <span class="border border-outline-variant rounded-lg py-2 flex flex-col items-center justify-center gap-xs peer-checked:border-primary peer-checked:ring-1 peer-checked:ring-primary hover:bg-surface-container-high transition-all text-secondary peer-checked:text-primary">
                            <span class="material-symbols-outlined text-[20px]">credit_card</span>
                            <span class="font-label-md text-[10px]">تحويل بنكي</span>
                        </span>
                    </label>
                </div>
                <!-- Bank DetaILS (shown when bank selected) -->
                <div id="bankDetaILS" class="hidden flex flex-col gap-sm mt-sm p-sm bg-surface-container-low rounded-lg border border-outline-variant/50">
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-md text-label-md text-secondary">حساب الاستلام 
                            <span class="text-error">*</span>
                         </label>
                        <select id="accountSelect" class="w-full bg-surface border border-outline-variant rounded-lg py-2 px-3 focus:outline-none focus:border-primary text-body-md font-body-md text-on-surface appearance-none">
                            <option value="">اختر الحساب</option>
                        </select>
                    </div>
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-md text-label-md text-secondary">رقم حساب المشتري <span class="text-error">*</span></label>
                        <input class="bg-transparent border border-outline-variant rounded-lg px-sm py-2 font-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none" id="buyerAccountNumber" placeholder="رقم الحساب" type="text" />
                    </div>
                </div>
            </div>
        </section>
        <!-- Invoice Notes -->
        <section class="bg-surface-container-lowest rounded-xl shadow-[0px_4px_20px_rgba(0,0,0,0.02)] border border-outline-variant/50 p-md">
            <div class="flex items-center justify-between mb-sm">
                <h3 class="font-title-lg text-title-lg font-bold text-on-surface flex items-center gap-xs">
                    <span class="material-symbols-outlined text-primary">notes</span>
                    ملاحظات الفاتورة
                </h3>
            </div>
            <textarea id="invoiceNotes" class="w-full bg-transparent border border-outline-variant rounded-lg px-sm py-2 font-body-md text-on-surface focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-shadow resize-y min-h-[60px]" placeholder="ملاحظات عامة على الفاتورة (اختياري)" rows="2"></textarea>
        </section>


    </div>

    <!-- Right/Side Summary Area -->
    <div class="xl:col-span-4 relative">
        <div class="sticky top-[88px] flex flex-col gap-md">
            <!-- Financial Summary Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-[0px_10px_32px_rgba(0,0,0,0.06)] border border-outline-variant p-md flex flex-col gap-md relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-primary"></div>
                <h3 class="font-title-lg text-title-lg font-bold text-on-surface">ملخص الفاتورة</h3>
                <div class="flex flex-col gap-sm font-body-md text-on-surface">
                    <div class="flex justify-between items-center py-xs border-b border-outline-variant/30">
                        <span class="text-secondary">إجمالي الوزن (جم)</span>
                        <span class="font-data-mono" id="summaryTotalWeight">0.000</span>
                    </div>
                    <div class="flex justify-between items-center py-xs border-b border-outline-variant/30">
                        <span class="text-secondary">قيمة الذهب (<span class="font-data-mono">JOD</span>)</span>
                        <span class="font-data-mono font-bold text-primary" id="summaryGoldValue">0.000</span>
                    </div>
                </div>
                <!-- Grand Total -->
                <div class="bg-surface p-sm rounded-lg border border-outline-variant flex flex-col items-center justify-center mt-xs">
                    <span class="font-label-md text-secondary mb-1">الإجمالي المستحق <span class="text-error">*</span></span>
                    <div class="flex items-baseline gap-xs w-full justify-center">
                        <input id="totalAmount" class="w-28 bg-transparent border-b-2 border-primary text-center font-display-lg text-display-lg font-bold text-primary tracking-tight outline-none" dir="ltr" type="number" step="0.001" value="0" oninput="updateSummary()" />
                        <span class="font-data-mono text-secondary" id="summaryCurrency">JOD</span>
                    </div>
                </div>
                <!-- Payment DetaILS -->
                <div class="flex flex-col gap-sm bg-surface-container-low p-sm rounded-lg border border-outline-variant/50">
                    <div class="flex justify-between items-center">
                        <span class="text-secondary">المبلغ المدفوع</span>
                        <input id="amountPaid" class="w-28 bg-surface border border-outline-variant rounded px-2 py-1 font-data-mono text-left" dir="ltr" type="number" step="0.001" value="0" oninput="updateSummary()" />
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-secondary">الرصيد المتبقي</span>
                        <span class="font-data-mono font-bold" id="remainingBalance">0.000</span>
                    </div>
                </div>
                <!-- Action Buttons -->
                <div class="flex flex-col gap-sm mt-sm">
                    <button class="w-full bg-primary hover:bg-surface-tint text-on-primary font-title-lg text-body-md py-sm rounded-lg flex items-center justify-center gap-sm transition-all shadow-md active:scale-[0.98]" onclick="submitInvoice()">
                        <span class="material-symbols-outlined">receipt_long</span>
                        إصدار الفاتورة
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sales-invoices.js" asp-append-version="true"></script>
}
