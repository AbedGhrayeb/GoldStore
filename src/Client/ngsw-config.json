{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/assets/**/*",
          "/*.woff2",
          "/icons/*.png"
        ]
      }
    },
    {
      "name": "lazy-chunks",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/chunk-*.js"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "gold-prices",
      "urls": ["/api/v1/gold-prices/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 4,
        "maxAge": "1d",
        "timeout": "2s"
      }
    },
    {
      "name": "reference",
      "urls": ["/api/v1/reference/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 8,
        "maxAge": "24h",
        "timeout": "3s"
      }
    },
    {
      "name": "kpis",
      "urls": [
        "/api/v1/*/kpis",
        "/api/v1/*/*/kpis",
        "/api/v1/dashboard/**",
        "/api/v1/inventory/**",
        "/api/v1/finance/**/kpis",
        "/api/v1/expenses/kpis"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "10m",
        "timeout": "5s"
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**", "!/host/**"]
}
